---
import type { CollectionEntry } from "astro:content";
import { STATUS_LABEL } from "../lib/departmnt";

interface Props {
  entry: CollectionEntry<"work">;
  index: number;
}
const { entry, index } = Astro.props;
const { title, categories, clients, cover, capacity, stats, departmnt } = entry.data;
const num = String(index).padStart(2, "0");
const clientNames = clients.map((c) => c.name).join(" · ");
const capacityLabel = capacity === "departmnt" ? "DEPARTMNT" : "Before DEPARTMNT";
const stat = stats?.[0];
---

<a
  href={`/work/${entry.id}`}
  data-work-card
  data-capacity={capacity}
  data-search={`${title} ${categories.join(" ")} ${clientNames}`.toLowerCase()}
  class="group grid grid-cols-[1fr_auto] items-center gap-6 py-8 transition-colors hover:bg-paper/[0.03] sm:grid-cols-[1fr_minmax(0,280px)_auto]"
>
  <div class="flex min-w-0 items-center gap-6 sm:gap-10">
    <span class="text-sm text-muted">({num})</span>
    <div class="h-16 w-24 shrink-0 overflow-hidden rounded-md bg-line/20 sm:h-20 sm:w-32">
      <img
        src={cover.replace(/\.(webp|jpe?g|png)$/i, "-thumb.webp")}
        onerror={`this.onerror=null;this.src=${JSON.stringify(cover)}`}
        alt={`${title}, ${categories.join(", ")}`}
        width="128"
        height="80"
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-widest text-muted">
        {categories.join(" / ")} <span class="text-line">·</span>{" "}
        <span class="font-carbon tracking-wider">{capacityLabel}</span>
        {departmnt?.labsSlug && (
          <>
            {" "}<span class="text-line">·</span> {STATUS_LABEL[departmnt.status]}
          </>
        )}
      </p>
      <p class="mt-1 text-xl font-semibold tracking-tight text-paper sm:text-2xl">{title}</p>
    </div>
  </div>
  {
    stat ? (
      <div class="hidden sm:block">
        <p class="text-2xl font-semibold tracking-tight text-paper">{stat.value}</p>
        <p class="mt-1 text-xs leading-snug text-muted">{stat.label}</p>
      </div>
    ) : (
      <span class="hidden sm:block" />
    )
  }
  <span
    class="shrink-0 rounded-full border border-line px-4 py-2 text-sm text-muted transition-colors group-hover:border-paper group-hover:text-paper"
    aria-hidden="true"
  >
    ↗
  </span>
</a>
