---
// Logo↔video pairings pulled directly from the reference site's DOM
// (each video card's sibling image), not guessed.
const items = [
  { video: "tEJyLiw78Otl9HT31lSl71Igd1Q", logo: "FjrV6A6BMgIskLefRyIyKKghyk", label: "H.LLS" },
  { video: "5olowgzf0BM9OmmN6A4xMDB6k", logo: "yuF8Glfc9MYdKuectWW9bWH02Dg", label: "Navinder Nangla" },
  { video: "FCXfnqK5mg3OLagHvnz8bTwiFVU", logo: "bqSpvsAFrdiCphSWU5uPtwaVbw", label: "Crocs" },
  { video: "Wx86FMdjp6N48XUOZVyO07ZCsE", logo: "AUEHB6WEWqPGdQCUOCZs3Kw2cJs", label: "G-Shock" },
  { video: "zwjFGabSp2mAmVuDqPu2ZZBOOc", logo: "E21lJiPj6h90n7vTYyeyZSiZ0Y", label: "Genesys" },
];
---

<div
  class="-mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-5 pb-4 sm:-mx-10 sm:px-10"
  data-partner-videos
>
  {
    items.map(({ video, logo, label }) => (
      <div class="relative aspect-[3/2] w-[85vw] shrink-0 snap-center overflow-hidden rounded-xl bg-line/20 sm:w-[420px]">
        <video
          src={`/videos/partners/${video}.mp4`}
          muted
          loop
          playsinline
          preload="none"
          class="h-full w-full object-cover"
          data-autoplay-in-view
        />
        <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
          <img src={`/images/logos/${logo}.png`} alt={label} class="max-h-[12%] max-w-[35%] object-contain" />
        </div>
      </div>
    ))
  }
</div>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>("[data-autoplay-in-view]");
  // Belt-and-braces: set the muted property in JS too, not just the HTML
  // attribute — some browsers can let sound through on a script-triggered
  // play() after user interaction if only the attribute is set.
  videos.forEach((v) => {
    v.muted = true;
    v.volume = 0;
  });
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          video.muted = true;
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      }
    },
    { threshold: 0.5 }
  );
  videos.forEach((v) => io.observe(v));
</script>

<style>
  [data-partner-videos] {
    scrollbar-width: thin;
  }
</style>
