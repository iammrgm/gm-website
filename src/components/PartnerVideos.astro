---
const items = [
  { video: "tEJyLiw78Otl9HT31lSl71Igd1Q", label: "H.LLS" },
  { video: "5olowgzf0BM9OmmN6A4xMDB6k", label: "Navinder Nangla" },
  { video: "FCXfnqK5mg3OLagHvnz8bTwiFVU", label: "Crocs" },
  { video: "Wx86FMdjp6N48XUOZVyO07ZCsE", label: "G-Shock" },
  { video: "zwjFGabSp2mAmVuDqPu2ZZBOOc", label: "Genesys" },
];
---

<div
  class="-mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-5 pb-4 sm:-mx-10 sm:px-10"
  data-partner-videos
>
  {
    items.map(({ video, label }) => (
      <div class="relative aspect-[9/16] w-[70vw] shrink-0 snap-center overflow-hidden rounded-xl bg-line/20 sm:w-[320px]">
        <video
          src={`/videos/partners/${video}.mp4`}
          muted
          loop
          playsinline
          preload="none"
          class="h-full w-full object-cover"
          data-autoplay-in-view
        />
        <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/80 to-transparent p-4">
          <p class="text-sm font-semibold uppercase tracking-widest text-paper">{label}</p>
        </div>
      </div>
    ))
  }
</div>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>("[data-autoplay-in-view]");
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      }
    },
    { threshold: 0.5 }
  );
  videos.forEach((v) => io.observe(v));
</script>

<style>
  [data-partner-videos] {
    scrollbar-width: thin;
  }
</style>
