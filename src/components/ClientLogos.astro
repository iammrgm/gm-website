---
// Most of these are transparent-background line-art logos, so a
// brightness-0/invert filter safely normalizes them to a white mark.
// Boiler Room's is a filled black circle with white text baked in —
// that filter crushes the whole thing to a blank white disc, so it's
// left unfiltered and rendered as-is instead.
const logoIds = [
  "T8uAOScR0xkvP4hhxllTYf1ZPI4",
  "AvKlIpwI4O2Ws5lHYtL7BWaSY",
  "R2myBgMMbe0q7niUKEh9od3Zdw",
  "E21lJiPj6h90n7vTYyeyZSiZ0Y",
  "Wr0gyvkynQO6OB9JGga4qfdrV0",
  "FjrV6A6BMgIskLefRyIyKKghyk",
  "rfiZuSlNifP1XA00obYNVBpbTUE",
  "y96VKNNaIjlQE3bFRtU3N8Hc4",
  "bqSpvsAFrdiCphSWU5uPtwaVbw",
  "zJqyT4D83X29dP9syrdfPsOdfzo",
  "AUEHB6WEWqPGdQCUOCZs3Kw2cJs",
  "VGysfM7eIhu9bvbn1d7vVmqqs1I",
  "SW3j5FpP9H6YKwpbJv505JfMwHA",
];
const NO_INVERT = new Set(["AvKlIpwI4O2Ws5lHYtL7BWaSY"]);
// Grid is 5 columns wide, so round up to a full row of empty slots —
// keeps the grid rectangular and ready for more logos later instead
// of ending mid-row.
const COLS = 5;
const totalSlots = Math.ceil(logoIds.length / COLS) * COLS;
const emptySlots = totalSlots - logoIds.length;
---

<div
  class="grid grid-cols-3 gap-px overflow-hidden rounded-lg border border-line/15 bg-line/15 sm:grid-cols-5"
  aria-label="Client and partner logos"
>
  {
    logoIds.map((id) => (
      <div class="flex aspect-[169/154] items-center justify-center bg-ink">
        <img
          src={`/images/logos/${id}.png`}
          alt=""
          loading="lazy"
          class:list={[
            "max-h-8 max-w-[45%] object-contain opacity-80 sm:max-h-10",
            !NO_INVERT.has(id) && "brightness-0 invert",
          ]}
        />
      </div>
    ))
  }
  {Array.from({ length: emptySlots }).map(() => <div class="aspect-[169/154] bg-ink" />)}
</div>
