---
const photos = [
  { src: "/images/about/navinder-brick-lane.webp", alt: "Gareth Matthews AI Keynote at Barclays London" },
  { src: "/images/about/bar-tokyo.webp", alt: "Gareth Matthews in Japan for BOOGLE Asia Tour" },
  { src: "/images/about/boiler-room-lee-valley.webp", alt: "Gareth Matthews headshot" },
];
---

<div class="grid grid-cols-3 gap-3 sm:gap-4">
  {
    photos.map((photo) => (
      <div class="group aspect-[3/4] overflow-hidden rounded-lg bg-line/20">
        <img
          src={photo.src}
          alt={photo.alt}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
      </div>
    ))
  }
</div>
