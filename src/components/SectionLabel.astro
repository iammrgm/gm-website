---
interface Props {
  mark: string;
  subtitle?: string;
}
const { mark, subtitle } = Astro.props;
---

<div class="border-t border-line pt-4">
  <span class="text-xs font-semibold uppercase tracking-widest text-muted">© {mark}</span>
</div>
{
  subtitle ? (
    <p class="mt-2 text-sm font-semibold uppercase tracking-widest text-paper">{subtitle}</p>
  ) : (
    <p class="mt-2 text-sm font-semibold uppercase tracking-widest text-paper">
      <slot />
    </p>
  )
}
