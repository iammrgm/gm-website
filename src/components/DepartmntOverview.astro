---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { STATUS_LABEL, departmntWorkUrl } from "../lib/departmnt";

interface Props {
  entry: CollectionEntry<"work">;
}
const { entry } = Astro.props;
const { title, categories, clients, duration, location, liveUrl, stats, pullQuote } = entry.data;
const d = entry.data.departmnt!;
const { Content } = await render(entry);
const fullCaseStudy = departmntWorkUrl(d.labsSlug);
const [hero, ...room] = d.room;

const galleries = [
  { label: "In the room", items: room, shape: "room" },
  { label: "The tags", items: d.tags, shape: "tag" },
  { label: "The Portal", items: d.portal, shape: "portal" },
  { label: "The office, in Core", items: d.core, shape: "core" },
].filter((g) => g.items.length > 0);
---

<p class="mt-6 max-w-3xl text-2xl font-medium leading-snug tracking-tight text-paper/80 sm:text-3xl">
  {d.headline}
</p>

{
  hero && (
    <div class="mt-12 aspect-[16/9] w-full overflow-hidden rounded-2xl bg-line/20" data-reveal>
      <img src={hero.image} alt={hero.alt} class="h-full w-full object-cover" fetchpriority="high" />
    </div>
  )
}

<div class="mt-16 grid gap-16 lg:grid-cols-[1fr_320px]">
  <div>
    <p class="text-xs font-semibold uppercase tracking-widest text-muted">Overview</p>
    <article class="prose-work mt-2 max-w-2xl space-y-6 text-lg text-paper/90">
      <Content />
    </article>
    <a
      href={fullCaseStudy}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-block rounded-full bg-paper px-6 py-3 text-sm font-semibold text-ink transition-opacity hover:opacity-80"
    >
      Full case study on DEPARTMNT ↗
    </a>
  </div>

  <aside class="space-y-8 border-t border-line pt-8 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-muted">Status</p>
      <p class="mt-1 flex items-center gap-2 text-paper">
        <span
          class:list={[
            "inline-block h-2 w-2 rounded-full",
            d.status === "live" ? "bg-paper" : d.status === "opening" ? "border border-paper" : "bg-muted",
          ]}
        ></span>
        {STATUS_LABEL[d.status]}
      </p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-muted">Capacity</p>
      <p class="font-carbon mt-1 tracking-wider text-paper">DEPARTMNT</p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-muted">Category</p>
      <div class="mt-2 flex flex-wrap gap-2">
        {categories.map((cat) => <span class="rounded-full border border-line px-3 py-1 text-xs text-paper">{cat}</span>)}
      </div>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-muted">Client</p>
      <p class="mt-1 text-paper">
        {
          clients.map((c, i) => (
            <>
              {c.url ? (
                <a
                  href={c.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-paper/30 underline-offset-4 hover:text-muted"
                >
                  {c.name} ↗
                </a>
              ) : (
                c.name
              )}
              {i < clients.length - 1 && " · "}
            </>
          ))
        }
      </p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-muted">Location</p>
      <p class="mt-1 text-paper">{location}</p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-muted">Timing</p>
      <p class="mt-1 text-paper">{duration}</p>
    </div>
    {
      d.tagsUsed.length > 0 && (
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Tags used</p>
          <p class="mt-1 text-paper">{d.tagsUsed.join(", ")}</p>
        </div>
      )
    }
    {
      liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-full border border-line px-5 py-2.5 text-sm text-paper transition-colors hover:border-paper"
        >
          Live Website ↗
        </a>
      )
    }
  </aside>
</div>

{
  stats && stats.length > 0 && (
    <section class="mt-20 border-y border-line py-10" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-widest text-muted">What it returned</p>
      <div class="mt-6 grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5">
        {stats.map((stat) => (
          <div>
            <p class="text-3xl font-semibold tracking-tight text-paper sm:text-4xl">{stat.value}</p>
            <p class="mt-1 text-sm leading-snug text-muted">{stat.label}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-xs text-muted">Figures from the DEPARTMNT project record.</p>
    </section>
  )
}

<section class="mt-20 grid gap-10 lg:grid-cols-[1fr_320px]" data-reveal>
  <div>
    <p class="text-xs font-semibold uppercase tracking-widest text-muted">What we learned</p>
    <p class="mt-4 max-w-3xl text-2xl font-medium leading-snug tracking-tight text-paper sm:text-3xl">
      {d.learned}
    </p>
  </div>
  {
    d.next && (
      <div class="border-t border-line pt-8 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">What happened next</p>
        <p class="mt-2 text-paper/80">{d.next}</p>
      </div>
    )
  }
</section>

{
  pullQuote && (
    <blockquote class="mt-20 max-w-2xl border-l-2 border-line pl-6" data-reveal>
      <p class="text-2xl font-medium leading-snug tracking-tight text-paper sm:text-3xl">“{pullQuote.text}”</p>
      <cite class="mt-3 block text-sm not-italic text-muted">{pullQuote.source}</cite>
    </blockquote>
  )
}

{
  galleries.map((g) => (
    <section class="mt-20" data-reveal>
      <p class="border-t border-line pt-4 text-xs font-semibold uppercase tracking-widest text-muted">{g.label}</p>
      <div
        class:list={[
          "mt-6 grid gap-4",
          g.shape === "portal" && "grid-cols-2 sm:grid-cols-3 lg:grid-cols-5",
          g.shape === "tag" && "grid-cols-2 sm:grid-cols-3",
          g.shape === "room" && "sm:grid-cols-3",
          g.shape === "core" && "sm:grid-cols-2",
        ]}
      >
        {g.items.map((item) => (
          <figure>
            <div
              class:list={[
                "w-full overflow-hidden rounded-lg bg-line/20",
                g.shape === "portal" && "aspect-[9/19.5]",
                g.shape === "tag" && "flex aspect-square items-center justify-center bg-paper/[0.04] p-6",
                g.shape === "room" && "aspect-[4/3]",
                g.shape === "core" && "aspect-[16/10]",
              ]}
            >
              <img
                src={item.image}
                alt={item.alt}
                loading="lazy"
                class:list={[
                  g.shape === "tag" ? "max-h-full max-w-full object-contain" : "h-full w-full object-cover object-top",
                ]}
              />
            </div>
            <figcaption class="mt-2 text-xs text-muted">{item.alt}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  ))
}

<section class="mt-24 rounded-2xl border border-line p-8 sm:p-12" data-reveal>
  <p class="text-xs font-semibold uppercase tracking-widest text-muted">The full story</p>
  <p class="mt-4 max-w-2xl text-2xl font-medium leading-snug tracking-tight text-paper sm:text-3xl">
    The brief, the build and every screen are in the full case study on DEPARTMNT.
  </p>
  <a
    href={fullCaseStudy}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-8 inline-block rounded-full bg-paper px-6 py-3 text-sm font-semibold text-ink transition-opacity hover:opacity-80"
  >
    Read {title} on DEPARTMNT ↗
  </a>
</section>

<style>
  .prose-work :global(p) {
    color: rgba(245, 244, 241, 0.75);
  }
  .prose-work :global(p:first-child) {
    color: var(--color-paper);
  }
</style>
