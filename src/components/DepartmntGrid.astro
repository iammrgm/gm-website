---
import type { CollectionEntry } from "astro:content";
import { STATUS_LABEL, departmntWorkUrl } from "../lib/departmnt";

// DEPARTMNT projects are told in full on departmnt.xyz, so each card links straight there.
interface Props {
  entries: CollectionEntry<"work">[];
}
const { entries } = Astro.props;
---

<ul class="grid-12 gap-y-12">
  {
    entries.map((entry) => {
      const { title, categories, location, cover, departmnt } = entry.data;
      const d = departmnt!;
      const image = d.room[0] ?? { image: cover, alt: "" };
      return (
        <li class="col-span-2 md:col-span-3">
          <a href={departmntWorkUrl(d.labsSlug)} target="_blank" rel="noopener noreferrer" class="group block">
            <div class="aspect-[4/3] overflow-hidden bg-tint">
              <img
                src={image.image}
                alt={image.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-opacity duration-200 group-hover:opacity-85"
              />
            </div>
            <div class="mt-3 flex items-baseline justify-between gap-3">
              <h3 class="text-[17px] leading-snug font-medium underline-offset-[0.2em] group-hover:underline">{title}</h3>
              <span class="meta shrink-0">{STATUS_LABEL[d.status]}</span>
            </div>
            <p class="mt-1 text-[15px] leading-snug text-mute">{d.headline}</p>
            <p class="meta mt-2">
              {categories[0]} · {location}
            </p>
          </a>
        </li>
      );
    })
  }
</ul>
