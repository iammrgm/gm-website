---
import type { CollectionEntry } from "astro:content";
import { STATUS_LABEL, departmntWorkUrl } from "../lib/departmnt";

// DEPARTMNT projects are told in full on departmnt.xyz, so each one links straight there.
// Laid out as a magazine spread: a large landscape frame beside a smaller portrait one,
// offset, with the pairing flipped on alternate rows.
interface Props {
  entries: CollectionEntry<"work">[];
}
const { entries } = Astro.props;

const layout = [
  { col: "md:col-span-7", aspect: "aspect-[3/2]", offset: "" },
  { col: "md:col-span-4 md:col-start-9", aspect: "aspect-[4/5]", offset: "md:mt-40" },
  { col: "md:col-span-4", aspect: "aspect-[4/5]", offset: "md:mt-16" },
  { col: "md:col-span-7 md:col-start-6", aspect: "aspect-[3/2]", offset: "md:mt-48" },
];
---

<ul class="grid-12 gap-y-16 md:gap-y-24">
  {
    entries.map((entry, i) => {
      const { title, categories, location, cover, departmnt } = entry.data;
      const d = departmnt!;
      const image = d.room[0] ?? { image: cover, alt: "" };
      const l = layout[i % layout.length];
      return (
        <li class:list={["col-span-4", l.col, l.offset]}>
          <a href={departmntWorkUrl(d.labsSlug)} target="_blank" rel="noopener noreferrer" class="group block">
            <div class:list={["frame-open overflow-hidden bg-tint", l.aspect]}>
              <div class="ease-out-expo h-full w-full transition-transform duration-700 group-hover:scale-[1.035]">
                <img src={image.image} alt={image.alt} loading="lazy" decoding="async" class="drift h-full w-full object-cover" />
              </div>
            </div>
            <div class="mt-4 flex items-baseline justify-between gap-4">
              <h3 class="text-[22px] leading-tight font-medium tracking-[-0.015em] md:text-[26px]">
                <span class="draw">{title}</span>
              </h3>
              <span class="meta shrink-0">{STATUS_LABEL[d.status]}</span>
            </div>
            <p class="mt-2 max-w-[30em] text-[16px] leading-snug text-mute">{d.headline}</p>
            <p class="meta mt-3 flex flex-wrap justify-between gap-x-4 gap-y-1">
              <span>{categories[0]} · {location}</span>
              <span class="text-fg">Case study on departmnt.xyz ↗</span>
            </p>
          </a>
        </li>
      );
    })
  }
</ul>
