---
const links = [
  { href: "/", label: "Home" },
  { href: "/work", label: "Work" },
  { href: "https://iammrgm.substack.com/", label: "Thoughts", external: true },
  { href: "/#contact", label: "Contact" },
];
---

<header class="fixed inset-x-0 top-0 z-50 mix-blend-difference">
  <div class="mx-auto grid max-w-[1480px] grid-cols-3 items-center px-5 py-5 sm:px-10">
    <a href="/" class="text-sm font-bold tracking-tight text-paper">GM®</a>
    <a
      href="/"
      class="justify-self-center text-center text-xs font-bold uppercase tracking-tight text-paper sm:text-sm"
    >
      Gareth Matthews
    </a>
    <div class="justify-self-end">
      <nav class="hidden items-center gap-8 sm:flex">
        {
          links.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
              class="text-sm font-medium text-paper/80 transition-colors hover:text-paper"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <a
        href="/#contact"
        class="text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4 sm:hidden"
      >
        Contact
      </a>
    </div>
  </div>
</header>
