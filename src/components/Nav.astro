---
const links = [
  { href: "/work", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/thoughts", label: "Thoughts" },
  { href: "/contact", label: "Contact" },
];
const path = Astro.url.pathname;
---

<header
  class="frame ease-out-expo sticky top-0 z-50 border-b border-rule bg-bg transition-transform duration-500"
  data-site-header
>
  <div class="grid-12 h-12 items-center text-[15px]">
    <a href="/" class="col-span-1 font-medium md:col-span-6">
      <span class="md:hidden">GM</span><span class="draw hidden md:inline">Gareth Matthews</span>
    </a>
    <nav class="col-span-3 flex justify-end gap-4 md:col-span-6 md:gap-7" aria-label="Main">
      {
        links.map((link) => {
          const current = path.startsWith(link.href);
          return (
            <a
              href={link.href}
              aria-current={current ? "page" : undefined}
              class:list={["draw transition-colors hover:text-fg", current ? "text-fg" : "text-mute"]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  // Slides the header away while reading down the page and brings it back on any scroll up.
  let lastY = 0;
  let ticking = false;
  const update = () => {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (!header) return;
    const y = window.scrollY;
    const hide = y > 120 && y > lastY;
    header.style.transform = hide ? "translateY(-100%)" : "";
    lastY = y;
    ticking = false;
  };
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true }
  );
  document.addEventListener("astro:page-load", () => {
    lastY = window.scrollY;
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (header) header.style.transform = "";
  });
</script>
