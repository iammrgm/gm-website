---
const links = [
  { href: "/work/", label: "Work" },
  { href: "/about/", label: "About" },
  // Thoughts live on Substack for now.
  { href: "https://iammrgm.substack.com/", label: "Thoughts", external: true },
  { href: "/contact/", label: "Contact" },
];
const path = Astro.url.pathname;
---

<header class="frame sticky top-0 z-50 border-b border-rule bg-bg">
  <div class="grid-12 h-12 items-center text-[15px]">
    <a href="/" class="col-span-1 font-medium md:col-span-6">
      <span class="name text-[13px] tracking-[-0.01em]"><span class="md:hidden">GM</span><span class="hidden md:inline">Gareth Matthews</span></span>
    </a>
    <nav class="col-span-3 flex justify-end gap-4 md:col-span-6 md:gap-7" aria-label="Main">
      {
        links.map((link) => {
          const current = !link.external && path.startsWith(link.href);
          return (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "me noopener noreferrer" : undefined}
              aria-current={current ? "page" : undefined}
              class:list={[
                "transition-colors hover:text-fg",
                current ? "text-fg underline underline-offset-[0.3em]" : "text-mute",
              ]}
            >
              {link.label}
              {link.external && <span class="sr-only"> (Substack, opens in a new tab)</span>}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
