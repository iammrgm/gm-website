---
// Inner-page opener: the page title large on the left, the intro beside it on desktop and under
// it on phones, bottoms aligned. Keeps every page starting the same way as the homepage sections.
interface Props {
  title: string;
}
const { title } = Astro.props;
const hasIntro = Astro.slots.has("default");
---

<header class="grid-12 gap-y-5 md:items-end">
  <h1 class="display col-span-4 text-[16vw] md:col-span-6 md:text-[7.4vw] 2xl:text-[108px]">{title}</h1>
  {
    hasIntro && (
      <div class="col-span-4 max-w-[30em] text-[18px] leading-[1.35] tracking-[-0.005em] md:col-span-5 md:col-start-8 md:pb-[0.4vw] md:text-[19px]">
        <slot />
      </div>
    )
  }
</header>
