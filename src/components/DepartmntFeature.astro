---
import type { CollectionEntry } from "astro:content";
import Mark from "./Mark.astro";
import { STATUS_LABEL, departmntWorkUrl } from "../lib/departmnt";
import { WORK_LOGO } from "../lib/brands";

// One DEPARTMNT project told large: a strip of three portrait photographs across the page (one on
// phones), then the title and result on the left with the story and link on the right. Links out
// to the full case study. Projects without a chosen set fall back to their first room photo.
interface Props {
  entry: CollectionEntry<"work">;
}
const { entry } = Astro.props;
const { title, categories, location, description, cover, departmnt } = entry.data;
const d = departmnt!;
// Picked from the departmnt.xyz set: the shots that carry the room best at portrait shape.
const STRIPS: Record<string, { image: string; alt: string }[]> = {
  "crocs-kasina": [
    { image: "/images/work/crocs-kasina/feature-first-clue.webp", alt: "The Portal in hand, showing the first clue" },
    { image: "/images/work/crocs-kasina/feature-lantern.webp", alt: "A lantern held over a plinth, finding what is hidden there" },
    { image: "/images/work/crocs-kasina/feature-cup.webp", alt: "A glowing Kasina × Crocs cup under UV light" },
  ],
};
const strip = STRIPS[entry.id] ?? [d.room[0] ?? { image: cover, alt: title }];
const logo = WORK_LOGO[entry.id];
const href = departmntWorkUrl(d.labsSlug);
---

<a href={href} target="_blank" rel="noopener noreferrer" class="group block">
  <div class:list={["relative grid gap-3 md:gap-4", strip.length > 1 && "md:grid-cols-3"]}>
    {
      strip.map((img, i) => (
        <div
          class:list={[
            "overflow-hidden rounded-xl bg-tint",
            strip.length > 1 ? "aspect-[4/5]" : "aspect-[4/3] md:aspect-[21/9]",
            i > 0 && "hidden md:block",
          ]}
        >
          <img
            src={img.image}
            alt={img.alt}
            loading="lazy"
            decoding="async"
            width="1200"
            height="1500"
            class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.015]"
          />
        </div>
      ))
    }
    <span class="status-chip absolute top-3 left-3 md:top-4 md:left-4">{STATUS_LABEL[d.status]}</span>
  </div>
  <div class="mt-4 flex items-center justify-between gap-4">
    <p class="meta">{categories[0]} · {location}</p>
    {logo && <Mark logo={logo} area={1400} max={24} />}
  </div>
  <div class="grid-12 mt-4 gap-y-4 md:mt-5">
    <div class="col-span-4 md:col-span-6">
      <h3 class="text-[32px] leading-[1.02] font-medium tracking-[-0.03em] underline-offset-[0.12em] group-hover:underline md:text-[44px]">
        {title}
      </h3>
      <p class="mt-3 max-w-[24em] text-[19px] leading-[1.3] tracking-[-0.01em] md:text-[22px]">{d.headline}</p>
    </div>
    <div class="col-span-4 md:col-span-5 md:col-start-8 md:pt-2">
      <p class="max-w-[30em] text-[16px] leading-snug text-mute">{description}</p>
      <p class="mt-4">
        <span class="ln">Read the case study on departmnt.xyz</span> <span aria-hidden="true">↗</span>
      </p>
    </div>
  </div>
</a>
