---
import type { CollectionEntry } from "astro:content";
import Mark from "./Mark.astro";
import { STATUS_LABEL, departmntWorkUrl } from "../lib/departmnt";
import { WORK_LOGO } from "../lib/brands";

// One DEPARTMNT project told large, the way departmnt.xyz/work opens: the headline beside a
// single big photograph. Links out to the full case study.
interface Props {
  entry: CollectionEntry<"work">;
}
const { entry } = Astro.props;
const { title, categories, location, description, cover, departmnt } = entry.data;
const d = departmnt!;
const image = d.room[0] ?? { image: cover, alt: title };
const logo = WORK_LOGO[entry.id];
const href = departmntWorkUrl(d.labsSlug);
---

<a href={href} target="_blank" rel="noopener noreferrer" class="group grid-12 gap-y-6">
  <div class="col-span-4 flex flex-col md:order-2 md:col-span-7 md:col-start-6">
    <div class="relative aspect-[4/3] overflow-hidden rounded-xl bg-tint">
      <img
        src={image.image}
        alt={image.alt}
        loading="lazy"
        decoding="async"
        width="1200"
        height="900"
        class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
      />
      <span class="status-chip absolute top-3 left-3">{STATUS_LABEL[d.status]}</span>
    </div>
  </div>
  <div class="col-span-4 flex flex-col md:order-1 md:col-span-5">
    <div class="flex items-center justify-between gap-4 border-b border-rule pb-3">
      <p class="meta">{categories[0]} · {location}</p>
      {logo && <Mark logo={logo} area={1400} max={24} />}
    </div>
    <h3 class="mt-5 text-[34px] leading-[1.02] font-medium tracking-[-0.03em] md:mt-6 md:text-[48px]">
      {title}
    </h3>
    <p class="mt-4 max-w-[22em] text-[20px] leading-[1.3] tracking-[-0.01em] md:text-[24px]">{d.headline}</p>
    <p class="mt-4 max-w-[30em] text-[16px] leading-snug text-mute">{description}</p>
    <p class="mt-8">
      <span class="ln">Read the case study on departmnt.xyz</span> <span aria-hidden="true">↗</span>
    </p>
  </div>
</a>
