---
import { DEPARTMNT_SITE } from "../lib/departmnt";

const CONTACT_EMAIL = "hello@departmnt.xyz";
const CALENDLY_URL = "https://calendly.com/gareth-departmnt/30min";

const elsewhere = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/gareth-matthews/" },
  { label: "Instagram", href: "https://instagram.com/iammrgm" },
  { label: "X", href: "https://x.com/iammrgm" },
  { label: "Substack", href: "https://iammrgm.substack.com/" },
];

const departmnt = [
  { label: "departmnt.xyz", href: DEPARTMNT_SITE },
  { label: "Instagram", href: "https://www.instagram.com/departmnt_hq/" },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/departmnt-hq/" },
  { label: "X", href: "https://x.com/departmnt_hq" },
];
---

<footer id="contact" class="frame mt-24 border-t border-fg pt-6 pb-8 md:mt-32">
  <div class="grid-12 gap-y-10">
    <div class="col-span-4 md:col-span-6">
      <p class="meta">Get in touch</p>
      <a href={`mailto:${CONTACT_EMAIL}`} class="ln mt-3 block text-[28px] leading-tight font-medium tracking-tight md:text-[40px]">
        {CONTACT_EMAIL}
      </a>
      <p class="mt-4 flex flex-wrap gap-x-6 gap-y-1">
        <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="ln">Book a 30-minute call</a>
        <a href="/contact" class="ln">Send a message</a>
      </p>
    </div>
    <div class="col-span-2 md:col-span-3">
      <p class="meta">Elsewhere</p>
      <ul class="mt-3 space-y-1">
        {elsewhere.map((l) => <li><a href={l.href} target="_blank" rel="me noopener noreferrer" class="ln">{l.label}</a></li>)}
      </ul>
    </div>
    <div class="col-span-2 md:col-span-3">
      <p class="meta">DEPARTMNT</p>
      <ul class="mt-3 space-y-1">
        {departmnt.map((l) => <li><a href={l.href} target="_blank" rel="noopener noreferrer" class="ln">{l.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="grid-12 mt-16 items-end">
    <p class="meta col-span-2 md:col-span-6">© {new Date().getFullYear()} Gareth Matthews · London</p>
    <p class="meta col-span-2 text-right md:col-span-6">
      <a href="/press" class="hover:text-fg">Press</a> · <a href="/privacy" class="hover:text-fg">Privacy</a>
    </p>
  </div>
</footer>
