---
import Marquee from "./Marquee.astro";
import SectionLabel from "./SectionLabel.astro";

const requestOptions = [
  "Request Meeting",
  "Speaking Enquiry",
  "Partnership",
  "Press & Media",
  "Advisory",
  "Something else?",
];

const SUBSTACK_URL = "https://iammrgm.substack.com/";

const networks = [
  { label: "Instagram", href: "https://instagram.com/iammrgm" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/gareth-matthews/" },
  { label: "SubStack", href: SUBSTACK_URL },
  { label: "X", href: "https://x.com/iammrgm" },
];

const departmntNetworks = [
  { label: "Instagram", href: "https://www.instagram.com/departmnt_hq/" },
  { label: "X", href: "https://x.com/departmnt_hq" },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/departmnt-hq/" },
];

const CONTACT_EMAIL = "hello@departmnt.xyz";
---

<Marquee items={["Speaking", "Partnerships", "Press", "Advisory"]} size="sm" />

<footer id="contact" class="border-t border-line bg-ink">
  <div class="mx-auto max-w-[1480px] px-5 py-20 sm:px-10">
    <SectionLabel mark="CONTACT" number="05" subtitle="Open Lines" />

    <form class="mt-10 grid max-w-2xl gap-6" data-contact-form action="/api/contact" method="post">
      <label class="grid gap-2">
        <span class="text-sm text-muted">Name</span>
        <input
          type="text"
          name="name"
          required
          class="border-b border-line bg-transparent py-3 text-lg text-paper outline-none placeholder:text-muted focus:border-paper"
        />
      </label>
      <label class="grid gap-2">
        <span class="text-sm text-muted">Email</span>
        <input
          type="email"
          name="email"
          required
          class="border-b border-line bg-transparent py-3 text-lg text-paper outline-none placeholder:text-muted focus:border-paper"
        />
      </label>
      <label class="grid gap-2">
        <span class="text-sm text-muted">Request</span>
        <select
          name="request"
          required
          class="border-b border-line bg-transparent py-3 text-lg text-paper outline-none focus:border-paper"
        >
          <option value="" selected disabled>Select…</option>
          {requestOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
      </label>
      <button
        type="submit"
        class="mt-4 w-fit rounded-full bg-paper px-8 py-3 text-sm font-semibold text-ink transition-opacity hover:opacity-80"
      >
        Submit
      </button>
      <p class="hidden text-sm text-muted" data-contact-status></p>
    </form>

    <p class="mt-16 max-w-xl text-lg text-muted">
      I build places. Physical or digital, loud or quiet, but always alive. If you're building
      something at the edge of culture and technology, or you want to put me in front of a room,
      get in touch.
    </p>

    <a
      href={`mailto:${CONTACT_EMAIL}`}
      class="mt-6 inline-block text-sm font-semibold text-paper underline decoration-paper/30 underline-offset-4"
    >
      Email Me
    </a>

    <div class="mt-20 flex flex-col flex-wrap gap-10 border-t border-line pt-10 sm:flex-row sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">Quick Links</p>
        <div class="mt-3 flex flex-wrap gap-x-2 gap-y-1 text-sm text-paper">
          <a href="/" class="hover:text-muted">Home</a>,
          <a href="/work" class="hover:text-muted">Work</a>,
          <a href="/about" class="hover:text-muted">About</a>,
          <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer" class="hover:text-muted">Thoughts</a>,
          <a href="/press" class="hover:text-muted">Press</a>,
          <a href="/#contact" class="hover:text-muted">Contact</a>
        </div>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">Networks</p>
        <div class="mt-3 flex flex-wrap gap-x-2 gap-y-1 text-sm text-paper">
          {
            networks.map((n, i) => (
              <>
                <a href={n.href} target="_blank" rel="noopener noreferrer" class="hover:text-muted">
                  {n.label}
                </a>
                {i < networks.length - 1 && ","}
              </>
            ))
          }
        </div>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">DEPARTMNT</p>
        <div class="mt-3 flex flex-wrap gap-x-2 gap-y-1 text-sm text-paper">
          <a href="https://departmnt.xyz" target="_blank" rel="noopener noreferrer" class="hover:text-muted">
            departmnt.xyz
          </a>
          ,
          {
            departmntNetworks.map((n, i) => (
              <>
                <a href={n.href} target="_blank" rel="noopener noreferrer" class="hover:text-muted">
                  {n.label}
                </a>
                {i < departmntNetworks.length - 1 && ","}
              </>
            ))
          }
        </div>
      </div>
      <p class="text-sm text-muted">
        ©{new Date().getFullYear()} · <a href="/privacy" class="hover:text-paper">Privacy</a>
      </p>
    </div>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = form?.querySelector<HTMLParagraphElement>("[data-contact-status]");
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status || !submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending…";
    status.classList.remove("hidden");
    status.textContent = "";

    try {
      const res = await fetch("/api/contact", { method: "POST", body: new FormData(form) });
      if (!res.ok) throw new Error("Request failed");
      status.textContent = "Thanks, I'll be in touch soon.";
      form.reset();
    } catch {
      status.textContent = "Something went wrong sending that. Try emailing directly instead.";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Submit";
    }
  });
</script>
