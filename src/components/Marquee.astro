---
// A thin strip of keywords in Carbon, looping slowly between sections.
interface Props {
  items: string[];
}
const { items } = Astro.props;
// Each half repeats the list so it fills even a very wide screen.
const half = [...items, ...items, ...items];
---

<div class="marquee flex overflow-hidden border-y border-rule py-3" role="img" aria-label={items.join(", ")}>
  {
    [0, 1].map(() => (
      <div class="marquee-group" aria-hidden="true">
        {half.map((item) => (
          <span class="meta flex items-center whitespace-nowrap text-fg">
            {item}
            <span class="mx-6 inline-block h-1 w-1 bg-fg md:mx-8" />
          </span>
        ))}
      </div>
    ))
  }
</div>
