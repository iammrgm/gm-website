---
interface Props {
  items: string[];
  class?: string;
  size?: "sm" | "lg";
}
const { items, class: className = "", size = "lg" } = Astro.props;
const loopItems = [...items, ...items, ...items, ...items];
const textSize = size === "sm" ? "text-sm sm:text-base" : "text-2xl sm:text-4xl";
const gap = size === "sm" ? "gap-6" : "gap-10";
const padding = size === "sm" ? "py-2.5" : "py-4";
---

<div class={`group relative overflow-hidden bg-paper ${padding} ${className}`}>
  <div class={`flex w-max animate-marquee ${gap} group-hover:[animation-play-state:paused]`}>
    {
      loopItems.map((item) => (
        <span class={`flex items-center ${gap} whitespace-nowrap font-semibold uppercase tracking-tight text-ink ${textSize}`}>
          {item}
          <span class="text-ink/30" aria-hidden="true">
            ✺
          </span>
        </span>
      ))
    }
  </div>
</div>

<style>
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-25%);
    }
  }
  .animate-marquee {
    animation: marquee 22s linear infinite;
  }
</style>
