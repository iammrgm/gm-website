---
interface Props {
  items: string[];
  class?: string;
}
const { items, class: className = "" } = Astro.props;
const loopItems = [...items, ...items, ...items, ...items];
---

<div class={`group relative overflow-hidden bg-paper py-4 ${className}`}>
  <div class="flex w-max animate-marquee gap-10 group-hover:[animation-play-state:paused]">
    {
      loopItems.map((item) => (
        <span class="flex items-center gap-10 whitespace-nowrap text-2xl font-semibold tracking-tight text-ink sm:text-4xl">
          {item}
          <span class="text-ink/30" aria-hidden="true">
            ✺
          </span>
        </span>
      ))
    }
  </div>
</div>

<style>
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-25%);
    }
  }
  .animate-marquee {
    animation: marquee 22s linear infinite;
  }
</style>
