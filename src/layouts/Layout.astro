---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { pageGraph, PROFILES } from "../lib/identity";
import fontMediumUrl from "../fonts/MonumentGrotesk-Medium.woff2?url";
import fontBoldUrl from "../fonts/MonumentGrotesk-Bold.woff2?url";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  profile?: boolean;
}

const {
  title,
  description = "Gareth Matthews: Founder & CEO, DEPARTMNT. Building the infrastructure for a more connected world.",
  ogImage = "/og.png",
  noindex = false,
  profile = false,
} = Astro.props;

const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url.origin).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();

const graph = pageGraph({ url: canonicalUrl, title, description, profile });
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fontMediumUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontBoldUrl} as="font" type="font/woff2" crossorigin />
    <meta name="google-site-verification" content="NEG8D2K0dc3PcRrwDLIjcKDZf7b_mIpBHlejomhGZ6g" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={profile ? "profile" : "website"} />
    {profile && <meta property="profile:first_name" content="Gareth" />}
    {profile && <meta property="profile:last_name" content="Matthews" />}
    <meta property="og:site_name" content="Gareth Matthews" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImage === "/og.png" ? "Gareth Matthews, Founder & CEO of DEPARTMNT" : title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@iammrgm" />
    <meta name="twitter:creator" content="@iammrgm" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImage === "/og.png" ? "Gareth Matthews, Founder & CEO of DEPARTMNT" : title} />
    {PROFILES.map((href) => <link rel="me" href={href} />)}
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <ClientRouter />
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "7fea4352744b4e4f91ddc06f411671ed"}'
    ></script>
  </head>
  <body class="min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-fg focus:px-4 focus:py-2 focus:text-sm focus:text-bg"
    >
      Skip to content
    </a>
    <Nav />
    <slot />
    <Footer />

  </body>
</html>
