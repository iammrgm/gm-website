---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import fontMediumUrl from "../fonts/MonumentGrotesk-Medium.woff2?url";
import fontBoldUrl from "../fonts/MonumentGrotesk-Bold.woff2?url";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Gareth Matthews: Founder & CEO, DEPARTMNT. Building the infrastructure for a more connected world.",
  ogImage = "/og.png",
  noindex = false,
} = Astro.props;

const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url.origin).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Gareth Matthews",
  jobTitle: "Founder & CEO",
  worksFor: {
    "@type": "Organization",
    name: "DEPARTMNT",
    url: "https://departmnt.xyz",
  },
  url: "https://www.garethmatthews.uk",
  sameAs: [
    "https://www.linkedin.com/in/gareth-matthews/",
    "https://instagram.com/iammrgm",
    "https://x.com/iammrgm",
    "https://iammrgm.substack.com/",
  ],
  knowsAbout: [
    "NFC infrastructure",
    "Ticketing systems",
    "Connected fashion",
    "Brand activation",
    "Live events",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fontMediumUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontBoldUrl} as="font" type="font/woff2" crossorigin />
    <meta name="google-site-verification" content="NEG8D2K0dc3PcRrwDLIjcKDZf7b_mIpBHlejomhGZ6g" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <ClientRouter />
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "7fea4352744b4e4f91ddc06f411671ed"}'
    ></script>
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-paper focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-ink"
    >
      Skip to content
    </a>
    <Nav />
    <slot />
    <Footer />

    <script>
      function initReveal() {
        document.documentElement.classList.add("js-reveal");
        const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
        if (!targets.length) return;

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -10% 0px" }
        );
        targets.forEach((el) => io.observe(el));
      }

      // Runs on first load and again after every client-side navigation.
      document.addEventListener("astro:page-load", initReveal);
    </script>
  </body>
</html>
