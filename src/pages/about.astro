---
import Layout from "../layouts/Layout.astro";

const cascadeLead =
  "Fifteen years watching culture generate attention no brand could hold onto, and brands spend fortunes reaching people they'd never be able to name. The room was always the asset.";
const cascadeClose = "Nobody was building for it. So I did.";

const memoNarrative = [
  "I started in rooms. DJing since I was 13, then a residency at Ministry of Sound, club nights at Egg and Brixton Academy, stage management at SW4 and Farr Festival. Then managing Novelist: booking his first world tour through Tokyo, Shanghai and Seoul, and his partnerships with Uniqlo, New Era and Casio G-Shock.",
  "Then I went to learn how the biggest brands actually work. Programme director on Mercedes-Benz, the National Lottery rebrand, AB InBev's BEES. National campaigns, global platforms, budgets in the millions.",
  "Both sides had the same gap. Culture creates attention no brand can hold on to. Brands spend fortunes reaching people they can never name. The value was always in the room, and everyone kept building for the screen.",
  "DEPARTMNT isn't a turn away from that past. It's the argument that past was making all along. We build the layer that lets a garment, a wristband or a door remember who was there, so the relationship made in the room doesn't disappear when the lights come up.",
  "In practice, it starts with a tap. Hold your phone to something real and it gives you more than it did a second ago: a ticket that knows you came, a jacket that unlocks the next drop, a wristband that brings you back to the artist a month later. For the person tapping, that's access to something they actually want. For the brand, it's the first time the people who showed up in person have a name, and a reason to hear from them again.",
  "That's the bigger shift. The digital world has always known what you care about. The physical world never could. We're giving it that context, one object at a time, so the things around you start working as hard for you as the phone in your pocket. Better experiences for the people in the room. Real relationships for the brands that bring them there. That's what we mean by the physical internet.",
];

const CALENDLY_URL = "https://calendly.com/gareth-departmnt/30min";

const eras = [
  { name: "Clubs", when: "From 13", text: "DJing, a residency at Ministry of Sound, club nights at Egg and Brixton Academy, stage management at SW4 and Farr Festival." },
  { name: "Artists", when: "2016 to 2017", text: "Managing Novelist: his first world tour through Tokyo, Shanghai and Seoul, and partnerships with Uniqlo, New Era and Casio G-Shock." },
  { name: "Boardrooms", when: "Agency years", text: "Programme lead on Mercedes-Benz, The National Lottery rebrand and AB InBev's BEES. National campaigns, global platforms." },
  { name: "DEPARTMNT", when: "2021 to now", text: "Founder and CEO. The layer that lets a garment, a wristband or a door remember who was there." },
];

const photos = [
  { src: "/images/about/bar-tokyo.webp", caption: "Japan, BOOGLE Asia Tour" },
  { src: "/images/about/boiler-room-lee-valley.webp", caption: "Portrait" },
  { src: "/images/about/navinder-brick-lane.webp", caption: "AI keynote, Barclays London" },
];

const memoPrinciples = [
  {
    title: "Everything is branding. Everything is experience.",
    description: "The queue, the door, the wristband, the message the morning after. People don't separate them, so I don't either.",
  },
  {
    title: "Build slow. Move fast.",
    description: "Take the time to get the foundations right, then move quickly on top of them.",
  },
  {
    title: "Never compete. Just create.",
    description: "When you're building something that doesn't exist yet, the only benchmark that matters is whether it works in the room.",
  },
  {
    title: "Create systems, not chaos.",
    description: "The programme years taught me that creative work only scales when the operation underneath it holds.",
  },
  {
    title: "Build things that outlast you.",
    description: "A campaign ends. Infrastructure keeps working after everyone's gone home.",
  },
];

const speakingTopics = [
  {
    title: "Connected products & NFC infrastructure",
    description: "Turning a physical object into the start of a relationship, not the end of a sale.",
  },
  {
    title: "From culture to commerce",
    description: "What brands get wrong about reaching audiences that don't live on a media plan.",
  },
  {
    title: "Building fan infrastructure",
    description: "Consent, identity and loyalty for artists and labels, without another app.",
  },
  {
    title: "Gamification in physical retail & events",
    description: "Designing discovery into a space instead of bolting on a screen.",
  },
  {
    title: "Artist-brand partnerships",
    description: "What actually works, from a decade managing talent on both sides of the deal.",
  },
  {
    title: "Founding inside culture",
    description: "Lessons from building DEPARTMNT at the edge of culture and technology.",
  },
];

const faqs = [
  {
    question: "What sectors do you work with?",
    answer:
      "Culture, music, fashion, retail and live events: anywhere a physical moment needs to become a digital relationship a brand can own.",
  },
  {
    question: "Where are you based?",
    answer: "London, UK. DEPARTMNT's projects run internationally.",
  },
  {
    question: "What kind of inquiries do you take?",
    answer:
      "Speaking engagements, partnerships, press & media and advisory work, alongside DEPARTMNT client enquiries; the contact page lets you say which, or you can book a call directly.",
  },
  {
    question: "Are you available for new projects?",
    answer: "Book a call or send a message, and I'll come back to you on timing.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout
  profile
  title="About Gareth Matthews | Founder & CEO, DEPARTMNT"
  description="Gareth Matthews: Founder & CEO of DEPARTMNT. From clubs and artist management to global brand programmes and DEPARTMNT: background, founder memo, speaking topics and FAQ."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <main id="main-content" class="frame pt-10 md:pt-14">
    <h1 class="display text-[22vw] md:text-[12vw] 2xl:text-[172px]">About</h1>

    <div class="grid-12 mt-10 gap-y-8 md:mt-14">
      <p class="col-span-4 max-w-[22em] text-[24px] leading-[1.25] tracking-[-0.01em] md:col-span-8 md:text-[32px]">
        {cascadeLead} {cascadeClose}
      </p>
    </div>

    <ul class="grid-12 mt-12 gap-y-8 md:mt-16">
      {
        photos.map((p) => (
          <li class="col-span-4 md:col-span-4">
            <img src={p.src} alt={`Gareth Matthews: ${p.caption}`} loading="lazy" class="aspect-[4/5] w-full rounded-xl bg-tint object-cover" />
            <p class="meta mt-2">{p.caption}</p>
          </li>
        ))
      }
    </ul>

    <!-- The long way round -->
    <section class="grid-12 mt-24 border-t border-fg pt-4 md:mt-32">
      <p class="meta col-span-4 md:col-span-3">The long way round</p>
      <ol class="col-span-4 mt-3 md:col-span-9 md:mt-0">
        {
          eras.map((era) => (
            <li class="grid grid-cols-1 gap-1 border-b border-rule py-4 first:pt-0 md:grid-cols-[12rem_9rem_1fr] md:gap-6">
              <span class="text-[20px] font-medium tracking-[-0.01em]">{era.name}</span>
              <span class="meta md:pt-1.5">{era.when}</span>
              <span class="text-[17px] text-mute">{era.text}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Founder memo -->
    <section class="grid-12 mt-24 border-t border-fg pt-4 md:mt-32">
      <p class="meta col-span-4 md:col-span-3">Founder memo</p>
      <div class="prose col-span-4 mt-3 md:col-span-7 md:mt-0">
        {memoNarrative.map((para) => <p>{para}</p>)}
      </div>
    </section>

    <!-- How I think -->
    <section class="grid-12 mt-24 border-t border-fg pt-4 md:mt-32">
      <p class="meta col-span-4 md:col-span-3">How I think</p>
      <ol class="col-span-4 mt-3 md:col-span-9 md:mt-0">
        {
          memoPrinciples.map((p, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] border-b border-rule py-4 first:pt-0 md:grid-cols-[3rem_1fr_1fr] md:gap-6">
              <span class="meta pt-1.5">{String(i + 1).padStart(2, "0")}</span>
              <span class="text-[20px] leading-snug font-medium tracking-[-0.01em]">{p.title}</span>
              <span class="col-start-2 mt-1 text-[17px] text-mute md:col-start-3 md:mt-0">{p.description}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Speaking -->
    <section class="grid-12 mt-24 border-t border-fg pt-4 md:mt-32">
      <p class="meta col-span-4 md:col-span-3">Speaking</p>
      <div class="col-span-4 mt-3 md:col-span-9 md:mt-0">
        <ul>
          {
            speakingTopics.map((t) => (
              <li class="grid gap-1 border-b border-rule py-4 first:pt-0 md:grid-cols-2 md:gap-6">
                <span class="text-[20px] leading-snug font-medium tracking-[-0.01em]">{t.title}</span>
                <span class="text-[17px] text-mute">{t.description}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-[15px] text-mute">
          Recent: AI keynote at Barclays, London. More talks and clips coming soon. To put me in front of a room,{" "}
          <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="ln text-fg">book a call</a>.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="grid-12 mt-24 border-t border-fg pt-4 md:mt-32">
      <p class="meta col-span-4 md:col-span-3">FAQ</p>
      <div class="col-span-4 mt-3 md:col-span-9 md:mt-0">
        {
          faqs.map((faq) => (
            <details class="group border-b border-rule py-4 first:pt-0">
              <summary class="flex cursor-pointer list-none items-baseline justify-between gap-4 text-[20px] font-medium tracking-[-0.01em]">
                {faq.question}
                <span class="meta shrink-0 group-open:hidden">Open</span>
                <span class="meta hidden shrink-0 group-open:inline">Close</span>
              </summary>
              <p class="mt-2 max-w-[38em] text-[17px] text-mute">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
