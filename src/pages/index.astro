---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import DepartmntGrid from "../components/DepartmntGrid.astro";
import WorkList from "../components/WorkList.astro";
import { DEPARTMNT_SITE } from "../lib/departmnt";
import { getVisibleThoughts } from "../lib/thoughts";

const CALENDLY_URL = "https://calendly.com/gareth-departmnt/30min";
const PORTRAIT = { src: "/images/about/headshot.webp", alt: "Gareth Matthews" };

const allWork = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const departmntWork = allWork.filter((w) => w.data.departmnt?.labsSlug);
const earlierWork = allWork.filter((w) => !w.data.departmnt?.labsSlug);
const thoughts = (await getVisibleThoughts()).slice(0, 3);
const dateFormatter = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric" });

const facts = [
  { label: "Based", value: "London" },
  { label: "Now", value: "Founder & CEO, DEPARTMNT" },
  { label: "Before", value: "Clubs, artist management, brand programmes" },
  { label: "Open to", value: "Speaking, advisory, partnerships, press, pilots" },
];

const clients = [
  "Crocs",
  "Kasina",
  "Atlantic Records",
  "10K Projects",
  "Casio G-SHOCK",
  "END.",
  "Mercedes-Benz",
  "AB InBev",
  "Coca-Cola",
  "The National Lottery",
  "Uniqlo",
  "New Era",
  "KFC",
  "O2",
  "Boiler Room",
];

const atmosphere = [
  { src: "/images/about/navinder-brick-lane.webp", caption: "AI keynote, Barclays London" },
  { src: "/images/about/bar-tokyo.webp", caption: "Japan, BOOGLE Asia Tour" },
  { src: "/images/about/boiler-room-lee-valley.webp", caption: "Portrait" },
];
---

<Layout title="Gareth Matthews: Founder & CEO, DEPARTMNT" profile>
  <main id="main-content">
    <!-- Introduction -->
    <section class="frame pt-10 md:pt-14">
      <h1 class="display text-[17.5vw] whitespace-normal md:text-[9.6vw] md:whitespace-nowrap 2xl:text-[138px]">
        <span class="rise inline-block align-top"><span style="--i:0">Gareth</span></span>
        <span class="rise inline-block align-top"><span style="--i:1">Matthews</span></span>
      </h1>
      <div class="grid-12 mt-10 gap-y-10 md:mt-14">
        <div class="col-span-4 md:col-span-6">
          <p class="fade-in max-w-[22em] text-[24px] leading-[1.25] tracking-[-0.01em] md:text-[30px]" style="--i:2">
            Founder and CEO of DEPARTMNT. Fifteen years across clubs, artists and boardrooms, now
            building the infrastructure for a more connected world.
          </p>
          <div class="fade-in mt-12 max-w-[34rem]" style="--i:3">
            <dl class="border-t border-rule">
              {
                facts.map((f) => (
                  <div class="grid grid-cols-[7rem_1fr] border-b border-rule py-2.5 md:grid-cols-[9rem_1fr]">
                    <dt class="meta pt-[3px]">{f.label}</dt>
                    <dd class="text-[15px]">{f.value}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="mt-5 flex flex-wrap gap-x-6 gap-y-1">
              <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="ln">Book a call</a>
              <a href="mailto:hello@departmnt.xyz" class="ln">Email</a>
              <a href="https://www.linkedin.com/in/gareth-matthews/" target="_blank" rel="me noopener noreferrer" class="ln">LinkedIn</a>
            </p>
          </div>
        </div>
        <figure class="col-span-4 md:col-span-5 md:col-start-8">
          <div class="aspect-[4/5] overflow-hidden bg-tint">
            <img
              src={PORTRAIT.src}
              alt={PORTRAIT.alt}
              fetchpriority="high"
              width="1200"
              height="1500"
              class="settle h-full w-full object-cover"
            />
          </div>
        </figure>
      </div>
    </section>

    <!-- DEPARTMNT -->
    <section class="frame mt-24 md:mt-32">
      <div class="grid-12 border-t border-fg pt-4">
        <p class="meta col-span-4 md:col-span-3">Now</p>
        <div class="col-span-4 mt-3 md:col-span-9 md:mt-0">
          <h2 class="text-[32px] leading-tight font-medium tracking-[-0.02em] md:text-[40px]">DEPARTMNT</h2>
          <p class="mt-3 max-w-[34em] text-[17px] text-mute">
            DEPARTMNT builds TapTech: the tags people tap, the Portal a tap opens, and Core, where brands
            run it. No app, ever. The full case studies are on{" "}
            <a href={`${DEPARTMNT_SITE}/work`} target="_blank" rel="noopener noreferrer" class="ln text-fg">departmnt.xyz</a>.
          </p>
        </div>
      </div>
      <div class="mt-12 md:mt-16">
        <DepartmntGrid entries={departmntWork.slice(0, 4)} />
      </div>
      <p class="mt-16 md:mt-24">
        <a href="/work" class="draw text-[20px] font-medium tracking-[-0.01em] md:text-[24px]">All {departmntWork.length} DEPARTMNT projects</a>
      </p>
    </section>

    <!-- Before DEPARTMNT -->
    <section class="frame mt-24 md:mt-32">
      <div class="grid-12 border-t border-fg pt-4">
        <p class="meta col-span-4 md:col-span-3">Before</p>
        <div class="col-span-4 mt-3 md:col-span-9 md:mt-0">
          <h2 class="text-[32px] leading-tight font-medium tracking-[-0.02em] md:text-[40px]">Earlier work</h2>
          <p class="mt-3 max-w-[34em] text-[17px] text-mute">
            Artist management, live events and brand programmes, from Novelist's first world tour to
            Mercedes-Benz and The National Lottery.
          </p>
        </div>
      </div>
      <div class="mt-8">
        <WorkList entries={earlierWork} />
      </div>
    </section>

    <!-- About -->
    <section class="frame mt-24 md:mt-32">
      <div class="grid-12 border-t border-fg pt-4">
        <p class="meta col-span-4 md:col-span-3">About</p>
        <div class="col-span-4 mt-3 md:col-span-9 md:mt-0">
          <p class="max-w-[24em] text-[24px] leading-[1.25] tracking-[-0.01em] md:text-[30px]">
            Nightclubs, then boardrooms. Fifteen years watching culture generate attention no brand
            could hold onto. The room was always the asset. Nobody was building for it, so I did.
          </p>
          <a href="/about" class="draw mt-5 inline-block">Read the full story</a>
        </div>
      </div>
      <ul class="grid-12 mt-10 gap-y-8">
        {
          atmosphere.map((a, i) => (
            <li class:list={["col-span-4 md:col-span-3", i === 0 && "md:col-start-4"]}>
              <div class="frame-open aspect-[4/5] overflow-hidden bg-tint">
                <img src={a.src} alt={`Gareth Matthews: ${a.caption}`} loading="lazy" class="drift h-full w-full object-cover" />
              </div>
              <p class="meta mt-2">{a.caption}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Thoughts -->
    {
      thoughts.length > 0 && (
        <section class="frame mt-24 md:mt-32">
          <div class="grid-12 border-t border-fg pt-4">
            <p class="meta col-span-4 md:col-span-3">Thoughts</p>
            <ul class="col-span-4 mt-3 md:col-span-9 md:mt-0">
              {thoughts.map((t) => (
                <li class="border-b border-rule">
                  <a href={`/thoughts/${t.id}`} class="group grid grid-cols-[1fr_auto] items-baseline gap-4 py-3">
                    <span class="text-[20px] leading-snug font-medium underline-offset-[0.2em] group-hover:underline md:text-[24px]">
                      {t.data.title}
                      {t.data.draft && <span class="meta ml-2 align-middle">Draft</span>}
                    </span>
                    <span class="meta">{dateFormatter.format(t.data.date)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- Clients -->
    <section class="frame mt-24 md:mt-32">
      <div class="grid-12 border-t border-fg pt-4">
        <p class="meta col-span-4 md:col-span-3">Worked with</p>
        <p class="col-span-4 mt-3 max-w-[40em] text-[20px] leading-snug md:col-span-9 md:mt-0 md:text-[24px]">
          {clients.join(", ")}.
        </p>
      </div>
    </section>
  </main>
</Layout>
