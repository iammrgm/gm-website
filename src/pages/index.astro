---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Marquee from "../components/Marquee.astro";
import WorkCard from "../components/WorkCard.astro";
import SectionLabel from "../components/SectionLabel.astro";
import ClientLogos from "../components/ClientLogos.astro";
import AtmospherePhotos from "../components/AtmospherePhotos.astro";
import PartnerVideos from "../components/PartnerVideos.astro";
import RoleCycler from "../components/RoleCycler.tsx";

const allWork = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
// The live site features the first 5 works, in CMS order.
const featured = allWork.slice(0, 5);

---

<Layout title="Gareth Matthews: Founder & CEO, DEPARTMNT">
  <main id="main-content">
    <!-- Hero -->
    <section class="mx-auto max-w-[1480px] px-5 pt-32 sm:px-10">
      <p class="text-sm font-semibold uppercase tracking-widest text-muted">
        Gareth Matthews: Founder &amp; CEO, DEPARTMNT
      </p>
      <div class="mt-4 grid gap-8 sm:grid-cols-[1.3fr_1fr] sm:items-end" data-reveal>
        <h1 class="text-left text-6xl font-medium leading-[1.05] tracking-tight text-paper sm:text-8xl">
          Building the infrastructure for a more connected world.
        </h1>
        <div class="aspect-video w-full overflow-hidden rounded-2xl bg-line/20">
          <video
            class="h-full w-full object-cover"
            src="/videos/hero/hero-loop.mp4"
            poster="/videos/hero/poster.jpg"
            autoplay
            muted
            loop
            playsinline
            disablepictureinpicture
            aria-label="Gareth Matthews"
          ></video>
        </div>
      </div>

      <div class="mt-8">
        <SectionLabel mark="PROFILE" number="01">
          <RoleCycler client:load />
        </SectionLabel>
      </div>
    </section>

    <!-- Profile: headshot spans the full column, copy + logos wrap beside it -->
    <section class="mx-auto max-w-[1480px] px-5 py-20 sm:px-10">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-stretch" data-reveal>
        <div class="aspect-[3/5] w-full shrink-0 overflow-hidden rounded-2xl bg-line/20 sm:w-[478px]">
          <img
            src="/images/about/headshot.webp"
            alt="Gareth Matthews, Founder and CEO of DEPARTMNT"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="flex min-w-0 flex-1 flex-col justify-center gap-8">
          <div>
            <p class="max-w-lg text-xl text-muted sm:text-2xl">
              15+ years<sup class="text-xs">™</sup> across culture and commerce, and the growing
              conviction that the two were never properly wired together.
            </p>
            <a
              href="/#contact"
              class="mt-6 inline-block rounded-full bg-paper px-8 py-3 text-sm font-semibold text-ink transition-opacity hover:opacity-80"
            >
              Contact
            </a>
          </div>
          <ClientLogos />
        </div>
      </div>
    </section>

    <Marquee items={["Culture", "Commerce", "Infrastructure", "Systems"]} size="sm" />

    <!-- About (teaser — full story, founder memo, speaking and FAQ live on /about) -->
    <section class="mx-auto max-w-[1480px] px-5 py-28 sm:px-10">
      <SectionLabel mark="ABOUT" number="02" subtitle="The Long Way Round" />

      <p class="mt-10 max-w-xl text-2xl font-medium tracking-tight text-paper sm:text-3xl" data-reveal>
        Nightclubs, then boardrooms.
      </p>

      <div class="mt-12" data-reveal>
        <AtmospherePhotos />
      </div>

      <div class="mt-16 max-w-2xl" data-reveal>
        <p class="text-2xl font-medium leading-snug tracking-tight text-paper sm:text-3xl">
          Fifteen years watching culture generate attention no brand could hold onto. The room
          was always the asset. Nobody was building for it. So I did.
        </p>
        <a
          href="/about"
          class="mt-6 inline-block text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4"
        >
          Read the full story, founder memo, speaking and FAQ →
        </a>
      </div>
    </section>

    <!-- Featured Work -->
    <section class="mx-auto max-w-[1480px] px-5 pb-28 sm:px-10">
      <SectionLabel mark="FEATURED WORK" number="03" subtitle="Fifteen Years, One Thread" />
      <div class="mt-10 flex items-baseline justify-between border-b border-line pb-6">
        <h2 class="text-2xl font-semibold tracking-tight">Select Works©</h2>
        <a href="/work" class="text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4">
          All works ({allWork.length})
        </a>
      </div>
      <div class="mt-2 divide-y divide-line" data-reveal>
        {featured.map((item, i) => <WorkCard entry={item} index={i + 1} />)}
      </div>
    </section>

    <!-- Brand Partners -->
    <section class="mx-auto max-w-[1480px] px-5 pb-28 sm:px-10">
      <SectionLabel mark="Featured Clients" number="04" subtitle="Select Clients" />
      <div class="mt-10" data-reveal>
        <PartnerVideos />
      </div>
    </section>
  </main>
</Layout>
