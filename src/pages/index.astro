---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SectionHead from "../components/SectionHead.astro";
import RoleCycler from "../components/RoleCycler.astro";
import Marquee from "../components/Marquee.astro";
import LogoWall from "../components/LogoWall.astro";
import DepartmntFeature from "../components/DepartmntFeature.astro";
import DepartmntGrid from "../components/DepartmntGrid.astro";
import WorkList from "../components/WorkList.astro";
import ClientFilms from "../components/ClientFilms.astro";
import { DEPARTMNT_SITE } from "../lib/departmnt";
import { getVisibleThoughts } from "../lib/thoughts";

const CALENDLY_URL = "https://calendly.com/gareth-departmnt/30min";

const allWork = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const departmntWork = allWork.filter((w) => w.data.departmnt?.labsSlug);
const earlierWork = allWork.filter((w) => !w.data.departmnt?.labsSlug);
const [featured, ...moreWork] = departmntWork;
// Only published pieces show here; until there are some, the section says "Coming soon".
const thoughts = (await getVisibleThoughts()).filter((t) => !t.data.draft).slice(0, 3);
const SUBSTACK_URL = "https://iammrgm.substack.com/";
const dateFormatter = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric" });

const facts = [
  { label: "Based", value: "London" },
  { label: "Now", value: "Founder & CEO, DEPARTMNT" },
  { label: "Before", value: "Clubs, artist management, brand programmes" },
  { label: "Open to", value: "Speaking, advisory, partnerships, press, pilots" },
];

const atmosphere = [
  { src: "/images/about/navinder-brick-lane.webp", caption: "AI keynote, Barclays London" },
  { src: "/images/about/bar-tokyo.webp", caption: "Japan, BOOGLE Asia Tour" },
  { src: "/images/about/boiler-room-lee-valley.webp", caption: "Portrait" },
];
---

<Layout title="Gareth Matthews: Founder & CEO, DEPARTMNT" profile>
  <main id="main-content">
    <!-- Hero: the name and line beside the founders film, tops aligned -->
    <section class="frame pt-8 md:pt-12">
      <div class="grid-12 gap-y-8 md:items-start">
        <div class="col-span-4 md:col-span-8">
          <h1 class="name text-[12.2vw] md:text-[8vw] 2xl:text-[120px]">
            <span class="block">Gareth </span><span class="block">Matthews</span>
          </h1>
          <p class="mt-6 max-w-[17em] text-[24px] leading-[1.12] font-medium tracking-[-0.022em] md:mt-8 md:text-[30px] lg:text-[36px]">
            Building the infrastructure for a more connected world.
          </p>
        </div>
        <figure class="col-span-4 md:col-span-4 md:col-start-9 md:mt-[0.75vw] 2xl:mt-[11px]">
          <div class="aspect-video overflow-hidden rounded-xl bg-fg">
            <video
              src="/videos/hero/hero-loop.mp4"
              poster="/videos/hero/poster.jpg"
              width="1280"
              height="720"
              autoplay
              muted
              loop
              playsinline
              disablepictureinpicture
              class="h-full w-full object-cover"
              aria-label="A conversation with the DEPARTMNT founders: Building a New Interface for Culture"
              data-hero-film
            ></video>
          </div>
          <figcaption class="mt-2 flex items-center justify-between gap-4">
            <span class="meta truncate">Film · A New Interface for Culture</span>
            <button type="button" class="meta shrink-0 text-fg hover:underline" data-hero-toggle aria-pressed="false">Pause</button>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Profile -->
    <section class="frame mt-12 md:mt-16">
      <div class="grid-12 gap-y-8 border-t border-fg pt-5 md:pt-6">
        <figure class="relative col-span-4 aspect-[4/5] md:col-span-5 md:aspect-auto">
          <img
            src="/images/about/headshot.webp"
            srcset="/images/about/headshot-thumb.webp 720w, /images/about/headshot.webp 1200w"
            sizes="(min-width: 768px) 42vw, 100vw"
            alt="Gareth Matthews, Founder and CEO of DEPARTMNT"
            width="1200"
            height="1500"
            loading="lazy"
            class="absolute inset-0 h-full w-full rounded-xl bg-tint object-cover object-[50%_30%]"
          />
        </figure>
        <div class="col-span-4 md:col-span-7">
          <p class="meta">Profile</p>
          <p class="mt-2 text-[34px] leading-none font-medium tracking-[-0.03em] md:text-[44px]">
            <RoleCycler />
          </p>
          <p class="mt-6 max-w-[21em] text-[22px] leading-[1.22] tracking-[-0.012em] md:text-[28px]">
            15+ years across culture and commerce, and the growing conviction that the two were never
            properly wired together.
          </p>
          <dl class="mt-8 border-t border-rule">
            {
              facts.map((f) => (
                <div class="grid grid-cols-[7rem_1fr] border-b border-rule py-2 md:grid-cols-[9rem_1fr]">
                  <dt class="meta pt-[3px]">{f.label}</dt>
                  <dd class="text-[15px]">{f.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-4 flex flex-wrap gap-x-6 gap-y-1">
            <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="ln">Book a call</a>
            <a href="/contact" class="ln">Send a message</a>
            <a href="https://www.linkedin.com/in/gareth-matthews/" target="_blank" rel="me noopener noreferrer" class="ln">LinkedIn</a>
          </p>
          <div class="mt-8">
            <p class="meta mb-3">Worked with</p>
            <LogoWall />
          </div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section class="frame mt-16 md:mt-20">
      <SectionHead mark="About" title="The Long Way Round" />
      <div class="grid-12 mt-8 gap-y-8 md:mt-10">
        <div class="col-span-4 md:col-span-5">
          <p class="text-[22px] leading-[1.22] tracking-[-0.012em] md:text-[28px]">Nightclubs, then boardrooms.</p>
          <p class="mt-3 text-[22px] leading-[1.22] tracking-[-0.012em] text-mute md:text-[28px]">
            Fifteen years watching culture generate attention no brand could hold onto. The room was always
            the asset. Nobody was building for it. So I did.
          </p>
          <a href="/about" class="ln mt-6 inline-block">Read the full story</a>
        </div>
        <ul class="col-span-4 grid grid-cols-3 gap-3 md:col-span-7 md:gap-4">
          {
            atmosphere.map((a) => (
              <li>
                <img
                  src={a.src.replace(/\.webp$/, "-thumb.webp")}
                  srcset={`${a.src.replace(/\.webp$/, "-thumb.webp")} 720w, ${a.src} 1200w`}
                  sizes="(min-width: 768px) 19vw, 31vw"
                  alt={`Gareth Matthews: ${a.caption}`}
                  width="1200"
                  height="1500"
                  loading="lazy"
                  class="aspect-[4/5] w-full rounded-xl bg-tint object-cover"
                />
                <p class="meta mt-2">{a.caption}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Work: DEPARTMNT -->
    <section class="frame mt-16 md:mt-20" id="work">
      <SectionHead mark="Work" title="Fifteen Years, One Thread">
        Since 2021, DEPARTMNT: the tags people tap, the Portal a tap opens, and Core, where brands run it.
        Every project opens its full case study on{" "}
        <a href={`${DEPARTMNT_SITE}/work`} target="_blank" rel="noopener noreferrer" class="ln text-fg">departmnt.xyz</a>.
        <a slot="action" href="/work" class="ln">All work ({allWork.length})</a>
      </SectionHead>
      {
        featured && (
          <div class="mt-10 md:mt-14">
            <DepartmntFeature entry={featured} />
          </div>
        )
      }
      <div class="mt-16 md:mt-20">
        <DepartmntGrid entries={moreWork.slice(0, 3)} />
      </div>
    </section>

    <!-- Select case studies: client films -->
    <section class="frame mt-16 md:mt-20">
      <SectionHead mark="Case studies" title="Select Case Studies" />
      <div class="mt-8 md:mt-10">
        <ClientFilms />
      </div>
    </section>

    <!-- Before DEPARTMNT -->
    <section class="frame mt-16 md:mt-20" id="before">
      <SectionHead mark="Before" title="Before DEPARTMNT">
        Artist management, live events and brand programmes, from Novelist's first world tour to
        Mercedes-Benz and The National Lottery.
        <a slot="action" href="/work#before" class="ln">All earlier work ({earlierWork.length})</a>
      </SectionHead>
      <div class="mt-8 md:mt-10">
        <WorkList entries={earlierWork.slice(0, 6)} dates={false} />
      </div>
    </section>

    <div class="mt-16 md:mt-20">
      <Marquee items={["Infrastructure", "Systems", "Culture", "Commerce"]} />
    </div>

    <!-- Thoughts -->
    <section class="frame mt-16 md:mt-20">
      <SectionHead mark="Thoughts" title={thoughts.length > 0 ? "Short Perspectives" : "Coming soon"}>
        {thoughts.length === 0 && "Short perspectives on culture, commerce and the rooms where they meet."}
        <a slot="action" href={SUBSTACK_URL} target="_blank" rel="me noopener noreferrer" class="ln">Substack ↗</a>
      </SectionHead>
      {
        thoughts.length > 0 && (
          <ul class="mt-6 border-t border-rule md:mt-8">
            {thoughts.map((t) => (
              <li class="border-b border-rule">
                <a href={`/thoughts/${t.id}`} class="group grid grid-cols-[1fr_auto] items-baseline gap-4 py-3">
                  <span class="text-[19px] leading-snug font-medium underline-offset-[0.2em] group-hover:underline md:text-[22px]">
                    {t.data.title}
                  </span>
                  <span class="meta">{dateFormatter.format(t.data.date)}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</Layout>

<script>
  function initHeroFilm() {
    const film = document.querySelector<HTMLVideoElement>("[data-hero-film]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-hero-toggle]");
    if (!film || !toggle) return;
    const set = (paused: boolean) => {
      if (paused) film.pause();
      else film.play().catch(() => {});
      toggle.textContent = paused ? "Play" : "Pause";
      toggle.setAttribute("aria-pressed", String(paused));
    };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) set(true);
    toggle.addEventListener("click", () => set(!film.paused));
  }
  document.addEventListener("astro:page-load", initHeroFilm);
</script>
