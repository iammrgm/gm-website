---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Marquee from "../components/Marquee.astro";
import WorkCard from "../components/WorkCard.astro";
import SectionLabel from "../components/SectionLabel.astro";
import ClientLogos from "../components/ClientLogos.astro";
import AtmospherePhotos from "../components/AtmospherePhotos.astro";
import PartnerVideos from "../components/PartnerVideos.astro";
import RoleCycler from "../components/RoleCycler.tsx";

const allWork = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
// The live site features the first 5 works, in CMS order.
const featured = allWork.slice(0, 5);

const cascade = [
  "Fifteen years watching culture generate attention no brand could hold onto,",
  "and brands spend fortunes reaching people they'd never be able to name.",
  "The room was always the asset.",
  "Nobody was building for it.",
  "So I did.",
];
---

<Layout title="Gareth Matthews — Founder & CEO, DEPARTMNT">
  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-[1480px] px-5 pt-32 sm:px-10">
      <p class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-widest text-muted">
        <RoleCycler client:load />
      </p>
      <div class="mt-6 grid gap-8 sm:grid-cols-[1.3fr_1fr] sm:items-end">
        <h1 class="text-5xl font-semibold leading-[1.05] tracking-tight sm:text-7xl">
          Building the infrastructure for a more connected world.
        </h1>
        <div class="aspect-[4/3] w-full overflow-hidden rounded-2xl bg-line/20 sm:aspect-square">
          <iframe
            class="h-full w-full"
            src="https://player.vimeo.com/video/704745692?autoplay=1&loop=1&muted=1&controls=0&title=0&byline=0&portrait=0&background=1"
            title="Gareth Matthews"
            allow="autoplay; fullscreen"
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <h2
        class="mt-10 select-none text-[15vw] font-bold leading-none tracking-tight text-paper sm:text-[9vw]"
      >
        GARETH MATTHEWS
      </h2>

      <div class="mt-6">
        <SectionLabel mark="PROFILE" number="01" subtitle="Founder / Builder / Operator" />
      </div>
    </section>

    <!-- Profile: tagline, contact, client logos -->
    <section class="mx-auto max-w-[1480px] px-5 py-20 sm:px-10">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-lg text-lg text-muted">
          15+ years<sup class="text-xs">™</sup> across culture and commerce — and the growing conviction
          that the two were never properly wired together.
        </p>
        <a
          href="/#contact"
          class="shrink-0 rounded-full bg-paper px-8 py-3 text-sm font-semibold text-ink transition-opacity hover:opacity-80"
        >
          Contact
        </a>
      </div>
      <div class="mt-12">
        <ClientLogos />
      </div>
    </section>

    <Marquee items={["Culture", "Commerce", "Infrastructure", "Systems"]} />

    <!-- About -->
    <section class="mx-auto max-w-[1480px] px-5 py-28 sm:px-10">
      <SectionLabel mark="ABOUT" number="02" subtitle="The Long Way Round" />

      <p class="mt-10 max-w-xl text-2xl font-medium tracking-tight text-paper sm:text-3xl">
        Nightclubs, then boardrooms.
      </p>

      <div class="mt-12">
        <AtmospherePhotos />
      </div>

      <div class="mt-16 grid gap-16 sm:grid-cols-2">
        <div class="space-y-6 text-2xl font-medium leading-snug tracking-tight text-paper sm:text-3xl">
          {cascade.map((line) => <p>{line}</p>)}
        </div>
        <div class="space-y-8 text-lg text-muted">
          <p>
            DEPARTMNT builds the infrastructure for connected products — tag, platform, app —
            turning a physical object into the start of a relationship rather than the end of a
            transaction.
          </p>
          <p>
            Nightclubs, national brands, artist campaigns, connected products. Different rooms,
            same question every time — how do you actually reach someone, and what happens once
            you have?
          </p>
        </div>
      </div>
    </section>

    <!-- Featured Work -->
    <section class="mx-auto max-w-[1480px] px-5 pb-28 sm:px-10">
      <SectionLabel mark="FEATURED WORK" number="03" subtitle="Fifteen Years, One Thread" />
      <div class="mt-10 flex items-baseline justify-between border-b border-line pb-6">
        <h3 class="text-2xl font-semibold tracking-tight">Select Works©</h3>
        <a href="/work" class="text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4">
          All works ({allWork.length})
        </a>
      </div>
      <div class="mt-2 divide-y divide-line">
        {featured.map((item, i) => <WorkCard entry={item} index={i + 1} />)}
      </div>
    </section>

    <!-- Brand Partners -->
    <section class="mx-auto max-w-[1480px] px-5 pb-28 sm:px-10">
      <SectionLabel mark="Brand Partners パートナー" brand="WDX®" number="08" subtitle="Creative Teams" />
      <div class="mt-10">
        <PartnerVideos />
      </div>
    </section>
  </main>
</Layout>
