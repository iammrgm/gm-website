---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Marquee from "../components/Marquee.astro";
import WorkCard from "../components/WorkCard.astro";
import SectionLabel from "../components/SectionLabel.astro";
import ClientLogos from "../components/ClientLogos.astro";
import AtmospherePhotos from "../components/AtmospherePhotos.astro";
import PartnerVideos from "../components/PartnerVideos.astro";
import RoleCycler from "../components/RoleCycler.tsx";

const allWork = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
// The live site features the first 5 works, in CMS order.
const featured = allWork.slice(0, 5);

const cascadeLead =
  "Fifteen years watching culture generate attention no brand could hold onto, and brands spend fortunes reaching people they'd never be able to name. The room was always the asset. Nobody was building for it. So I did.";
---

<Layout title="Gareth Matthews — Founder & CEO, DEPARTMNT">
  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-[1480px] px-5 pt-32 sm:px-10">
      <p class="text-sm font-semibold uppercase tracking-widest text-muted">
        <RoleCycler client:load />
      </p>
      <div class="mt-4 grid gap-8 sm:grid-cols-[1.3fr_1fr] sm:items-end">
        <h1 class="text-4xl font-medium leading-[1.1] tracking-tight text-paper sm:text-6xl">
          Building the infrastructure for a more connected world.
        </h1>
        <div class="aspect-[4/3] w-full overflow-hidden rounded-2xl bg-line/20 sm:aspect-square">
          <iframe
            class="h-full w-full"
            src="https://player.vimeo.com/video/704745692?autoplay=1&loop=1&muted=1&controls=0&title=0&byline=0&portrait=0&background=1"
            title="Gareth Matthews"
            allow="autoplay; fullscreen"
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <h2 class="mt-8 select-none text-center text-[10vw] font-semibold leading-none tracking-[-0.03em] text-paper sm:text-[5vw]">
        GARETH MATTHEWS
      </h2>

      <div class="mt-6">
        <SectionLabel mark="PROFILE" number="01" subtitle="Founder / Builder / Operator" />
      </div>
    </section>

    <!-- Profile: headshot spans the full column, copy + logos wrap beside it -->
    <section class="mx-auto max-w-[1480px] px-5 py-20 sm:px-10">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-stretch">
        <div class="aspect-[3/5] w-full shrink-0 overflow-hidden rounded-2xl bg-line/20 sm:w-[478px]">
          <img
            src="/images/about/headshot.png"
            alt="Gareth Matthews"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="flex min-w-0 flex-1 flex-col justify-center gap-8">
          <div>
            <p class="max-w-lg text-xl text-muted sm:text-2xl">
              15+ years<sup class="text-xs">™</sup> across culture and commerce — and the growing
              conviction that the two were never properly wired together.
            </p>
            <a
              href="/#contact"
              class="mt-6 inline-block rounded-full bg-paper px-8 py-3 text-sm font-semibold text-ink transition-opacity hover:opacity-80"
            >
              Contact
            </a>
          </div>
          <ClientLogos />
        </div>
      </div>
    </section>

    <Marquee items={["Culture", "Commerce", "Infrastructure", "Systems"]} size="sm" />

    <!-- About -->
    <section class="mx-auto max-w-[1480px] px-5 py-28 sm:px-10">
      <SectionLabel mark="ABOUT" number="02" subtitle="The Long Way Round" />

      <p class="mt-10 max-w-xl text-2xl font-medium tracking-tight text-paper sm:text-3xl">
        Nightclubs, then boardrooms.
      </p>

      <div class="mt-12">
        <AtmospherePhotos />
      </div>

      <div class="mt-16 max-w-3xl">
        <p class="text-3xl font-medium leading-snug tracking-tight text-paper sm:text-4xl">
          {cascadeLead}
        </p>
        <p class="mt-8 text-lg leading-relaxed text-muted sm:text-xl">
          DEPARTMNT builds the infrastructure for connected products — tag, platform, app —
          turning a physical object into the start of a relationship rather than the end of a
          transaction.
        </p>
        <p class="mt-6 text-lg leading-relaxed text-muted sm:text-xl">
          Nightclubs, national brands, artist campaigns, connected products. Different rooms,
          same question every time — how do you actually reach someone, and what happens once
          you have?
        </p>
      </div>
    </section>

    <!-- Featured Work -->
    <section class="mx-auto max-w-[1480px] px-5 pb-28 sm:px-10">
      <SectionLabel mark="FEATURED WORK" number="03" subtitle="Fifteen Years, One Thread" />
      <div class="mt-10 flex items-baseline justify-between border-b border-line pb-6">
        <h3 class="text-2xl font-semibold tracking-tight">Select Works©</h3>
        <a href="/work" class="text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4">
          All works ({allWork.length})
        </a>
      </div>
      <div class="mt-2 divide-y divide-line">
        {featured.map((item, i) => <WorkCard entry={item} index={i + 1} />)}
      </div>
    </section>

    <!-- Brand Partners -->
    <section class="mx-auto max-w-[1480px] px-5 pb-28 sm:px-10">
      <SectionLabel mark="Featured Clients" number="04" subtitle="Select Clients" />
      <div class="mt-10">
        <PartnerVideos />
      </div>
    </section>
  </main>
</Layout>
