---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found | Gareth Matthews" noindex>
  <main id="main-content" class="frame pt-10 md:pt-14">
    <p class="meta">404</p>
    <h1 class="display mt-4 text-[17vw] md:text-[10vw] 2xl:text-[150px]">This room's empty.</h1>
    <p class="mt-8 max-w-[26em] text-[22px] leading-[1.3]">
      Whatever you were looking for isn't here. Try <a href="/work" class="ln">the work</a> or go
      <a href="/" class="ln">home</a>.
    </p>
  </main>
</Layout>
