---
import Layout from "../layouts/Layout.astro";

const PRESS_EMAIL = "press@departmnt.xyz";
const GENERAL_EMAIL = "hello@departmnt.xyz";

const shortBio =
  "Gareth Matthews is the Founder & CEO of DEPARTMNT, building the infrastructure that connects physical products and live events to the brands and audiences behind them.";

const mediumBio =
  "Gareth Matthews is the Founder & CEO of DEPARTMNT. He has 15+ years in culture, music and global brand innovation, from artist management and live event production to programmes for Mercedes-Benz, AB InBev, Coca-Cola and The National Lottery. He started DEPARTMNT in 2021 and incorporated it in May 2025; Kadeem Henry later joined as co-founder. DEPARTMNT builds TapTech: the tags people tap, the Portal a tap opens and Core, where brands run it, turning physical products and live moments into a relationship a brand actually owns. No app, ever.";

const appearances = [
  "Barclays Rise, London: presented the E Gucewicz Genesis connected eyewear prototypes",
  "Breakpoint, Lisbon, November 2022: Genesis prototypes shown",
  "Featured in a WGSN keynote",
];

const coverage = [
  {
    title: "G-SHOCK news: the event, credited to TapTech powered by DEPARTMNT",
    outlet: "G-SHOCK Singapore",
    href: "https://gshock.casio.com/sg/g-news/events/2025/gshock-active-lifestyle/",
  },
  {
    title: "END. Features: Londone Fassion Weak",
    outlet: "END.",
    href: "https://www.endclothing.com/gb/features/navinder-nangla-presents-londone-fassion-weak",
  },
  {
    title: "G-Shock × Novelist, Lucien Clarke and Benny Fairfax",
    outlet: "Highsnobiety",
    href: "https://www.highsnobiety.com/p/g-shock-novelist-lucien-clarke-benny-fairfax/",
  },
  {
    title: "KFC brings gamers and grimers together",
    outlet: "Campaign",
    href: "https://www.campaignlive.co.uk/article/kfc-brings-gamers-grimers-together-facebook-live-video-first/1417532",
  },
];

const boilerplate = [
  "Gareth Matthews spent fifteen years watching culture generate attention no brand could hold onto, and brands spend fortunes reaching people they'd never be able to name. In 2021 he started DEPARTMNT to build the infrastructure for that instead: TapTech, the tags, Portal and Core that turn a physical object into the start of a relationship rather than the end of a transaction.",
  "Before DEPARTMNT, he built his career the same way brands couldn't: in the room, managing artists, building fan infrastructure, and running the connected layer behind product launches, live events and brand activations for clients including Mercedes-Benz, AB InBev, Coca-Cola and The National Lottery.",
];

const facts = [
  { label: "Role", value: "Founder & CEO, DEPARTMNT" },
  { label: "Location", value: "London, UK" },
  { label: "Company", value: "DEPARTMNT LABS UK LTD (departmnt.xyz). Started 2021, incorporated 21 May 2025" },
  { label: "Co-founder", value: "Kadeem Henry" },
  { label: "Focus", value: "NFC infrastructure, ticketing, connected fashion, brand activation, live events" },
  { label: "Background", value: "15+ years in culture, music and global brand innovation" },
];
---

<Layout
  title="Press | Gareth Matthews, Founder & CEO of DEPARTMNT"
  description="Press kit for Gareth Matthews, Founder & CEO of DEPARTMNT: boilerplate, bios, headshot and company facts for media use."
>
  <main id="main-content" class="frame pt-8 md:pt-12">
    <h1 class="display text-[18vw] md:text-[9vw] 2xl:text-[128px]">Press</h1>

    <div class="grid-12 mt-10 gap-y-12 border-t border-fg pt-6 md:mt-14">
      <div class="col-span-4 space-y-12 md:col-span-7">
        <section>
          <h2 class="meta">Boilerplate</h2>
          <div class="prose mt-3">{boilerplate.map((p) => <p>{p}</p>)}</div>
        </section>
        <section>
          <h2 class="meta">Short bio</h2>
          <p class="prose mt-3">{shortBio}</p>
        </section>
        <section>
          <h2 class="meta">Medium bio</h2>
          <p class="prose mt-3">{mediumBio}</p>
        </section>
        <section>
          <h2 class="meta">Appearances</h2>
          <ul class="mt-3 border-t border-rule">
            {appearances.map((a) => <li class="border-b border-rule py-3 text-[17px]">{a}</li>)}
          </ul>
        </section>
        <section>
          <h2 class="meta">Selected coverage</h2>
          <ul class="mt-3 border-t border-rule">
            {
              coverage.map((c) => (
                <li class="border-b border-rule py-3">
                  <a href={c.href} target="_blank" rel="noopener noreferrer" class="ln text-[17px]">{c.title}</a>
                  <span class="meta ml-2">{c.outlet}</span>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <aside class="col-span-4 md:col-span-4 md:col-start-9">
        <img
          src="/images/about/headshot.webp"
          alt="Gareth Matthews, Founder and CEO of DEPARTMNT"
          width="1200"
          height="1500"
          class="aspect-[4/5] w-full rounded-xl bg-tint object-cover"
        />
        <a href="/press/gareth-matthews-headshot.jpg" download class="ln mt-3 inline-block text-[15px]">
          Download headshot, JPG 1200 × 1500
        </a>
        <dl class="mt-10 border-t border-rule">
          {
            facts.map((f) => (
              <div class="border-b border-rule py-3">
                <dt class="meta">{f.label}</dt>
                <dd class="mt-1 text-[15px]">{f.value}</dd>
              </div>
            ))
          }
          <div class="border-b border-rule py-3">
            <dt class="meta">Press</dt>
            <dd class="mt-1"><a href={`mailto:${PRESS_EMAIL}`} class="ln text-[15px]">{PRESS_EMAIL}</a></dd>
          </div>
          <div class="border-b border-rule py-3">
            <dt class="meta">Everything else</dt>
            <dd class="mt-1"><a href={`mailto:${GENERAL_EMAIL}`} class="ln text-[15px]">{GENERAL_EMAIL}</a></dd>
          </div>
        </dl>
      </aside>
    </div>
  </main>
</Layout>
