---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import DepartmntGrid from "../../components/DepartmntGrid.astro";
import WorkList from "../../components/WorkList.astro";
import SectionHead from "../../components/SectionHead.astro";
import { DEPARTMNT_SITE } from "../../lib/departmnt";

const allWork = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const departmntWork = allWork.filter((w) => w.data.departmnt?.labsSlug);
const earlierWork = allWork.filter((w) => !w.data.departmnt?.labsSlug);
---

<Layout
  title="Work | Gareth Matthews"
  description={`${allWork.length} projects: connected products, fan infrastructure and events at DEPARTMNT, and the artist, brand and programme work that came before it.`}
>
  <main id="main-content" class="frame pt-8 md:pt-12">
    <h1 class="display text-[18vw] md:text-[9vw] 2xl:text-[128px]">Work</h1>

    <section id="departmnt" class="mt-10 scroll-mt-16 md:mt-14">
      <SectionHead mark={`Now · ${departmntWork.length}`} title="DEPARTMNT">
        Projects since founding DEPARTMNT in 2021. Each one opens the full case study on{" "}
        <a href={`${DEPARTMNT_SITE}/work`} target="_blank" rel="noopener noreferrer" class="ln text-fg">departmnt.xyz</a>.
      </SectionHead>
      <div class="mt-8 md:mt-10">
        <DepartmntGrid entries={departmntWork} />
      </div>
    </section>

    <section id="before" class="mt-16 scroll-mt-16 md:mt-20">
      <SectionHead mark={`Before · ${earlierWork.length}`} title="Before DEPARTMNT">
        Artist management, live events and brand programmes, from Novelist's first world tour to
        Mercedes-Benz and The National Lottery.
      </SectionHead>
      <div class="mt-6 md:mt-8">
        <WorkList entries={earlierWork} />
      </div>
    </section>
  </main>
</Layout>
