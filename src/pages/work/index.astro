---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import WorkCard from "../../components/WorkCard.astro";

const allWork = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Work | Gareth Matthews"
  description="19 case studies spanning connected products, brand activations, fan infrastructure and artist campaigns for Gareth Matthews and DEPARTMNT."
>
  <main id="main-content" class="mx-auto max-w-[1480px] px-5 pt-32 pb-28 sm:px-10">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">All Works ({allWork.length})</h1>
      <label class="relative w-full sm:w-64">
        <span class="sr-only">Search work</span>
        <input
          type="text"
          placeholder="Search by title, client, category…"
          data-work-search
          class="w-full border-b border-line bg-transparent py-2 text-sm text-paper outline-none placeholder:text-muted focus:border-paper"
        />
      </label>
    </div>
    <div class="mt-6 flex flex-wrap gap-2" data-capacity-filter>
      <button
        type="button"
        data-capacity-btn="all"
        class="font-carbon rounded-full border border-paper bg-paper px-4 py-1.5 text-xs uppercase tracking-wider text-ink"
      >
        All
      </button>
      <button
        type="button"
        data-capacity-btn="departmnt"
        class="font-carbon rounded-full border border-line px-4 py-1.5 text-xs uppercase tracking-wider text-muted transition-colors hover:border-paper hover:text-paper"
      >
        DEPARTMNT
      </button>
      <button
        type="button"
        data-capacity-btn="personal"
        class="font-carbon rounded-full border border-line px-4 py-1.5 text-xs uppercase tracking-wider text-muted transition-colors hover:border-paper hover:text-paper"
      >
        Personal / Agency-Era
      </button>
    </div>
    <p class="mt-4 hidden text-sm text-muted" data-work-empty>No work matches that search.</p>
    <div class="mt-8 divide-y divide-line border-t border-line" data-work-list data-reveal>
      {allWork.map((entry, i) => <WorkCard entry={entry} index={i + 1} />)}
    </div>
  </main>
</Layout>

<script>
  function initWorkSearch() {
    const input = document.querySelector<HTMLInputElement>("[data-work-search]");
    const cards = document.querySelectorAll<HTMLAnchorElement>("[data-work-card]");
    const empty = document.querySelector<HTMLParagraphElement>("[data-work-empty]");
    const capacityBtns = document.querySelectorAll<HTMLButtonElement>("[data-capacity-btn]");
    if (!input) return;

    let activeCapacity = "all";

    function applyFilters() {
      const q = input!.value.trim().toLowerCase();
      let visibleCount = 0;
      cards.forEach((card) => {
        const matchesSearch = !q || (card.dataset.search ?? "").includes(q);
        const matchesCapacity = activeCapacity === "all" || card.dataset.capacity === activeCapacity;
        const match = matchesSearch && matchesCapacity;
        card.classList.toggle("hidden", !match);
        if (match) visibleCount++;
      });
      empty?.classList.toggle("hidden", visibleCount !== 0);
    }

    input.value = "";
    input.addEventListener("input", applyFilters);

    capacityBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCapacity = btn.dataset.capacityBtn ?? "all";
        capacityBtns.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle("bg-paper", isActive);
          b.classList.toggle("border-paper", isActive);
          b.classList.toggle("text-ink", isActive);
          b.classList.toggle("border-line", !isActive);
          b.classList.toggle("text-muted", !isActive);
        });
        applyFilters();
      });
    });
  }

  document.addEventListener("astro:page-load", initWorkSearch);
</script>
