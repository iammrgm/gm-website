---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import WorkCard from "../../components/WorkCard.astro";

const allWork = (await getCollection("work")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<Layout title="Work — Gareth Matthews">
  <main class="mx-auto max-w-[1480px] px-5 pt-32 pb-28 sm:px-10">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">All Works ({allWork.length})</h1>
    <div class="mt-12 divide-y divide-line border-t border-line">
      {allWork.map((entry, i) => <WorkCard entry={entry} index={i + 1} />)}
    </div>
  </main>
</Layout>
