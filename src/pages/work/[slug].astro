---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import WorkCard from "../../components/WorkCard.astro";

export async function getStaticPaths() {
  const allWork = await getCollection("work");
  return allWork.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, categories, clients, duration, location, liveUrl, images, reel, video, pullQuote, stats, market } =
  entry.data;
const marketLabel = market === "departmnt" ? "DEPARTMNT" : "Personal / Agency-Era";
const { Content } = await render(entry);

// Only case studies whose source cover photo is high-res enough to crop to a
// clean 1200×630 OG image without visible upscaling get a dedicated crop
// (generated to /images/og/{slug}.jpg); the rest fall back to the site default.
const OG_CROPPED_SLUGS = new Set([
  "boogle-asia-tour",
  "crocs-kasina",
  "e-gucewicz-genesis",
  "g-shock-who-eats-art",
  "hlls-10k-projects",
  "mulaa-joans-atlantic",
  "novelist-boiler-room-o2",
  "novelist-casio-g-shock",
  "novelist-new-era",
  "novelist-rinse-kfc",
  "novelist-tours",
  "you-studio",
]);
const ogImage = OG_CROPPED_SLUGS.has(entry.id) ? `/images/og/${entry.id}.jpg` : undefined;

const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  description: entry.data.description,
  creator: { "@type": "Person", name: "Gareth Matthews" },
  about: categories.join(", "),
  ...(clients.length && {
    client: clients.map((c) => ({ "@type": "Organization", name: c.name, ...(c.url && { url: c.url }) })),
  }),
  ...(location && { locationCreated: location }),
  image: new URL(entry.data.cover, Astro.site ?? Astro.url.origin).toString(),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Work", item: new URL("/work", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: title, item: new URL(`/work/${entry.id}`, Astro.site).toString() },
  ],
};

const allWork = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allWork.findIndex((w) => w.id === entry.id);
const related = Array.from({ length: 2 }, (_, i) => allWork[(currentIndex + i + 1) % allWork.length]);
const prevWork = allWork[(currentIndex - 1 + allWork.length) % allWork.length];
const nextWork = allWork[(currentIndex + 1) % allWork.length];
---

<Layout
  title={`${title} | Gareth Matthews`}
  description={entry.data.description}
  ogImage={ogImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(caseStudySchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <main id="main-content" class="mx-auto max-w-[1480px] px-5 pt-32 pb-28 sm:px-10">
    <a href="/work" class="text-sm text-muted transition-colors hover:text-paper">{title} /</a>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">{title}</h1>

    <div class="mt-16 grid gap-16 lg:grid-cols-[1fr_320px]">
      <article class="prose-work max-w-2xl space-y-10 text-lg text-paper/90">
        <Content />
      </article>

      <aside class="space-y-8 border-t border-line pt-8 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Market</p>
          <p class="font-carbon mt-1 tracking-wider text-paper">{marketLabel}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Category</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {
              categories.map((cat) => (
                <span class="rounded-full border border-line px-3 py-1 text-xs text-paper">{cat}</span>
              ))
            }
          </div>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Client</p>
          <p class="mt-1 text-paper">
            {
              clients.map((c, i) => (
                <>
                  {c.url ? (
                    <a
                      href={c.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline decoration-paper/30 underline-offset-4 hover:text-muted"
                    >
                      {c.name} ↗
                    </a>
                  ) : (
                    c.name
                  )}
                  {i < clients.length - 1 && " · "}
                </>
              ))
            }
          </p>
        </div>
        {
          entry.data.role && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-muted">Role</p>
              <p class="mt-1 text-paper">{entry.data.role}</p>
            </div>
          )
        }
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Duration</p>
          <p class="mt-1 text-paper">{duration}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Location</p>
          <p class="mt-1 text-paper">{location}</p>
        </div>
        {
          liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-full border border-line px-5 py-2.5 text-sm text-paper transition-colors hover:border-paper"
            >
              Live Website ↗
            </a>
          )
        }
      </aside>
    </div>

    {
      stats && stats.length > 0 && (
        <div class="mt-16 grid grid-cols-2 gap-8 border-y border-line py-10 sm:grid-cols-4" data-reveal>
          {stats.map((stat) => (
            <div>
              <p class="text-3xl font-semibold tracking-tight text-paper sm:text-4xl">{stat.value}</p>
              <p class="mt-1 text-xs font-semibold uppercase tracking-widest text-muted">{stat.label}</p>
            </div>
          ))}
        </div>
      )
    }

    {
      pullQuote && (
        <blockquote class="mt-16 max-w-2xl border-l-2 border-line pl-6" data-reveal>
          <p class="text-2xl font-medium leading-snug tracking-tight text-paper sm:text-3xl">
            “{pullQuote.text}”
          </p>
          <cite class="mt-3 block text-sm not-italic text-muted">{pullQuote.source}</cite>
        </blockquote>
      )
    }

    {
      video && (
        <div class="mt-24 aspect-video w-full max-w-3xl overflow-hidden rounded-2xl bg-line/20" data-reveal>
          <video src={video} controls playsinline class="h-full w-full object-cover">
            <track kind="captions" />
          </video>
        </div>
      )
    }

    {
      reel && (
        <div class="mt-24 aspect-[9/16] w-full max-w-xs overflow-hidden rounded-2xl bg-line/20" data-reveal>
          <video src={reel} controls loop playsinline muted class="h-full w-full object-cover">
            <track kind="captions" />
          </video>
        </div>
      )
    }

    {
      images.length > 0 && (
        <div class="mt-24 grid gap-4 sm:grid-cols-2" data-reveal>
          {images.map((src, i) => (
            <div class="aspect-[4/3] w-full overflow-hidden rounded-lg bg-line/20">
              <img
                src={src}
                alt={`${title}, project photo ${i + 1} of ${images.length}`}
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>
          ))}
        </div>
      )
    }

    <div class="mt-24 border-t border-line pt-10">
      <p class="text-xs font-semibold uppercase tracking-widest text-muted">More Work</p>
      <div class="mt-2 divide-y divide-line">
        {related.map((item) => <WorkCard entry={item} index={item.data.order} />)}
      </div>
    </div>

    <div class="mt-16 flex items-center justify-between gap-6 border-t border-line pt-10">
      <a
        href={`/work/${prevWork.id}`}
        class="text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4"
      >
        ← {prevWork.data.title}
      </a>
      <a
        href={`/work/${nextWork.id}`}
        class="text-right text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4"
      >
        {nextWork.data.title} →
      </a>
    </div>

    <a
      href="/work"
      class="mt-10 inline-block text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4"
    >
      ← Back to all works
    </a>
  </main>
</Layout>

<style>
  .prose-work :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-paper);
    margin-top: 2rem;
  }
  .prose-work :global(p) {
    margin-top: 0.75rem;
    color: rgba(245, 244, 241, 0.75);
  }
  .prose-work :global(ul) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .prose-work :global(li) {
    margin-top: 0.5rem;
    color: rgba(245, 244, 241, 0.75);
  }
  .prose-work :global(li)::marker {
    color: rgba(245, 244, 241, 0.4);
  }
</style>
