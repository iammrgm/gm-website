---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import WorkCard from "../../components/WorkCard.astro";

export async function getStaticPaths() {
  const allWork = await getCollection("work");
  return allWork.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, categories, clients, duration, location, liveUrl, images, pullQuote, stats, market } = entry.data;
const marketLabel = market === "departmnt" ? "DEPARTMNT" : "Personal / Agency-Era";
const { Content } = await render(entry);

const allWork = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allWork.findIndex((w) => w.data.slug === entry.data.slug);
const related = Array.from({ length: 2 }, (_, i) => allWork[(currentIndex + i + 1) % allWork.length]);
const prevWork = allWork[(currentIndex - 1 + allWork.length) % allWork.length];
const nextWork = allWork[(currentIndex + 1) % allWork.length];
---

<Layout title={`${title} — Gareth Matthews`} description={entry.data.description}>
  <main class="mx-auto max-w-[1480px] px-5 pt-32 pb-28 sm:px-10">
    <a href="/work" class="text-sm text-muted transition-colors hover:text-paper">{title} /</a>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">{title}</h1>

    <div class="mt-16 grid gap-16 lg:grid-cols-[1fr_320px]">
      <article class="prose-work max-w-2xl space-y-10 text-lg text-paper/90">
        <Content />
      </article>

      <aside class="space-y-8 border-t border-line pt-8 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Market</p>
          <p class="font-carbon mt-1 tracking-wider text-paper">{marketLabel}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Category</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {
              categories.map((cat) => (
                <span class="rounded-full border border-line px-3 py-1 text-xs text-paper">{cat}</span>
              ))
            }
          </div>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Client</p>
          <p class="mt-1 text-paper">
            {
              clients.map((c, i) => (
                <>
                  {c.url ? (
                    <a
                      href={c.url}
                      target="_blank"
                      rel="noreferrer"
                      class="underline decoration-paper/30 underline-offset-4 hover:text-muted"
                    >
                      {c.name} ↗
                    </a>
                  ) : (
                    c.name
                  )}
                  {i < clients.length - 1 && " · "}
                </>
              ))
            }
          </p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Duration</p>
          <p class="mt-1 text-paper">{duration}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Location</p>
          <p class="mt-1 text-paper">{location}</p>
        </div>
        {
          liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noreferrer"
              class="inline-block rounded-full border border-line px-5 py-2.5 text-sm text-paper transition-colors hover:border-paper"
            >
              Live Website ↗
            </a>
          )
        }
      </aside>
    </div>

    {
      stats && stats.length > 0 && (
        <div class="mt-16 grid grid-cols-2 gap-8 border-y border-line py-10 sm:grid-cols-4" data-reveal>
          {stats.map((stat) => (
            <div>
              <p class="text-3xl font-semibold tracking-tight text-paper sm:text-4xl">{stat.value}</p>
              <p class="mt-1 text-xs font-semibold uppercase tracking-widest text-muted">{stat.label}</p>
            </div>
          ))}
        </div>
      )
    }

    {
      pullQuote && (
        <blockquote class="mt-16 max-w-2xl border-l-2 border-line pl-6" data-reveal>
          <p class="text-2xl font-medium leading-snug tracking-tight text-paper sm:text-3xl">
            “{pullQuote.text}”
          </p>
          <cite class="mt-3 block text-sm not-italic text-muted">— {pullQuote.source}</cite>
        </blockquote>
      )
    }

    {
      images.length > 0 && (
        <div class="mt-24 grid gap-4 sm:grid-cols-2" data-reveal>
          {images.map((src, i) => (
            <img
              src={src}
              alt={`${title} — project photo ${i + 1} of ${images.length}`}
              loading="lazy"
              class="w-full rounded-lg object-cover"
            />
          ))}
        </div>
      )
    }

    <div class="mt-24 border-t border-line pt-10">
      <p class="text-xs font-semibold uppercase tracking-widest text-muted">More Work</p>
      <div class="mt-2 divide-y divide-line">
        {related.map((item) => <WorkCard entry={item} index={item.data.order} />)}
      </div>
    </div>

    <div class="mt-16 flex items-center justify-between gap-6 border-t border-line pt-10">
      <a
        href={`/work/${prevWork.data.slug}`}
        class="text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4"
      >
        ← {prevWork.data.title}
      </a>
      <a
        href={`/work/${nextWork.data.slug}`}
        class="text-right text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4"
      >
        {nextWork.data.title} →
      </a>
    </div>

    <a
      href="/work"
      class="mt-10 inline-block text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4"
    >
      ← Back to all works
    </a>
  </main>
</Layout>

<style>
  .prose-work :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-paper);
    margin-top: 2rem;
  }
  .prose-work :global(p) {
    margin-top: 0.75rem;
    color: rgba(245, 244, 241, 0.75);
  }
</style>
