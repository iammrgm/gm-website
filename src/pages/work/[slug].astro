---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { PERSON_ID } from "../../lib/identity";

export async function getStaticPaths() {
  // DEPARTMNT projects live on departmnt.xyz (see public/_redirects); only earlier work has a page here.
  const allWork = (await getCollection("work")).filter((w) => !w.data.departmnt?.labsSlug);
  return allWork.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, categories, clients, duration, location, liveUrl, images, reel, video, pullQuote, stats } =
  entry.data;
const { Content } = await render(entry);

// Only case studies whose source cover photo is high-res enough to crop to a
// clean 1200×630 OG image without visible upscaling get a dedicated crop
// (generated to /images/og/{slug}.jpg); the rest fall back to the site default.
const OG_CROPPED_SLUGS = new Set([
  "boogle-asia-tour",
  "crocs-kasina",
  "e-gucewicz-genesis",
  "g-shock-who-eats-art",
  "hlls-10k-projects",
  "mulaa-joans-atlantic",
  "novelist-boiler-room-o2",
  "novelist-casio-g-shock",
  "novelist-new-era",
  "novelist-rinse-kfc",
  "novelist-tours",
  "you-studio",
]);
const ogImage = OG_CROPPED_SLUGS.has(entry.id) ? `/images/og/${entry.id}.jpg` : undefined;

const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  description: entry.data.description,
  creator: { "@id": PERSON_ID },
  about: categories.join(", "),
  ...(clients.length && {
    client: clients.map((c) => ({ "@type": "Organization", name: c.name, ...(c.url && { url: c.url }) })),
  }),
  ...(location && { locationCreated: location }),
  image: new URL(entry.data.cover, Astro.site ?? Astro.url.origin).toString(),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Work", item: new URL("/work", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: title, item: new URL(`/work/${entry.id}`, Astro.site).toString() },
  ],
};

const earlier = (await getCollection("work"))
  .filter((w) => !w.data.departmnt?.labsSlug)
  .sort((a, b) => a.data.order - b.data.order);
const currentIndex = earlier.findIndex((w) => w.id === entry.id);
const prevWork = earlier[(currentIndex - 1 + earlier.length) % earlier.length];
const nextWork = earlier[(currentIndex + 1) % earlier.length];
// Covers big enough to open the page full width without looking soft; the rest open on the text.
const LEAD_SLUGS = new Set([
  "boogle-asia-tour",
  "novelist-casio-g-shock",
  "novelist-rinse-kfc",
  "novelist-boiler-room-o2",
  "novelist-new-era",
  "novelist-tours",
]);
const lead = LEAD_SLUGS.has(entry.id) ? entry.data.cover : undefined;
const gallery = [...new Set([entry.data.cover, ...images])].filter((src) => src !== lead);
const facts = [
  ...(entry.data.artist ? [{ label: "Artist", value: entry.data.artist }] : []),
  { label: "Client", value: clients.map((c) => c.name).join(", "), links: clients },
  ...(entry.data.role ? [{ label: "Role", value: entry.data.role }] : []),
  { label: "Period", value: duration },
  { label: "Location", value: location },
  { label: "Category", value: categories.join(", ") },
];
---

<Layout title={`${title} | Gareth Matthews`} description={entry.data.description} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(caseStudySchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <main id="main-content" class="frame pt-8 md:pt-12">
    <a href="/work#before" class="meta hover:text-fg">← Work · Before DEPARTMNT{entry.data.artist && ` · With ${entry.data.artist}`}</a>
    <header class="grid-12 mt-4 gap-y-5 md:mt-5 md:items-end">
      <h1 class="display col-span-4 text-[12vw] md:col-span-7 md:text-[5.4vw] 2xl:text-[78px]">{title}</h1>
      <p class="col-span-4 max-w-[30em] text-[19px] leading-[1.35] tracking-[-0.005em] md:col-span-5 md:col-start-8 md:pb-[0.3vw] md:text-[20px]">
        {entry.data.description}
      </p>
    </header>

    {
      lead && (
        <img
          src={lead}
          alt={`${title}`}
          fetchpriority="high"
          decoding="async"
          class="mt-10 aspect-[4/3] w-full rounded-xl bg-tint object-cover md:mt-14 md:aspect-[2/1]"
        />
      )
    }

    <div class="grid-12 mt-10 gap-y-10 border-t border-fg pt-6 md:mt-14">
      <aside class="col-span-4 md:col-span-3">
        <dl>
          {
            facts.map((f) => (
              <div class="border-b border-rule py-2.5 first:pt-0">
                <dt class="meta">{f.label}</dt>
                <dd class="mt-1 text-[15px]">{f.value}</dd>
              </div>
            ))
          }
        </dl>
        {
          liveUrl && (
            <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="ln mt-4 inline-block text-[15px]">
              See it live
            </a>
          )
        }
      </aside>

      <div class="col-span-4 md:col-span-7 md:col-start-5">
        <article class="prose">
          <Content />
        </article>

        {
          stats && stats.length > 0 && (
            <table class="mt-12 w-full max-w-[38em] border-t border-fg text-left">
              <caption class="meta pb-3 text-left">In numbers</caption>
              <tbody>
                {stats.map((s) => (
                  <tr class="border-b border-rule">
                    <td class="w-[30%] py-3 pr-4 align-top text-[22px] font-medium tracking-[-0.01em]">{s.value}</td>
                    <td class="py-3 align-top text-[15px] text-mute">{s.label}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }

        {
          pullQuote && (
            <blockquote class="mt-12 max-w-[30em] border-l border-fg pl-5">
              <p class="text-[24px] leading-[1.3] tracking-[-0.01em]">“{pullQuote.text}”</p>
              <cite class="meta mt-3 block not-italic">{pullQuote.source}</cite>
            </blockquote>
          )
        }
      </div>
    </div>

    {
      (video || reel) && (
        <div class="grid-12 mt-14 gap-y-6">
          {video && (
            <video src={video} controls playsinline class="col-span-4 w-full rounded-xl bg-tint md:col-span-8">
              <track kind="captions" />
            </video>
          )}
          {reel && (
            <video src={reel} controls loop playsinline muted class="col-span-2 w-full rounded-xl bg-tint md:col-span-3">
              <track kind="captions" />
            </video>
          )}
        </div>
      )
    }

    {
      gallery.length > 0 && (
        <ul class="grid-12 mt-14 gap-y-4 md:gap-y-6">
          {gallery.map((src, i) => (
            <li class="col-span-4 md:col-span-6">
              <img
                src={src}
                alt={`${title}, image ${i + 1} of ${gallery.length}`}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full rounded-xl bg-tint object-cover"
              />
            </li>
          ))}
        </ul>
      )
    }

    <nav class="grid-12 mt-16 border-t border-fg pt-4 md:mt-20" aria-label="More work">
      <a href={`/work/${prevWork.id}`} class="group col-span-2 md:col-span-6">
        <span class="meta">Previous</span>
        <span class="mt-1 block text-[17px] font-medium underline-offset-[0.2em] group-hover:underline">{prevWork.data.title}</span>
      </a>
      <a href={`/work/${nextWork.id}`} class="group col-span-2 text-right md:col-span-6">
        <span class="meta">Next</span>
        <span class="mt-1 block text-[17px] font-medium underline-offset-[0.2em] group-hover:underline">{nextWork.data.title}</span>
      </a>
    </nav>
  </main>
</Layout>
