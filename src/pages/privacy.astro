---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";

const CONTACT_EMAIL = "hello@departmnt.xyz";
const LAST_UPDATED = "2 November 2026";

const sections = [
  {
    heading: "What this covers",
    body: [
      "This policy covers garethmatthews.uk: this site only, not DEPARTMNT's own product or client platforms.",
    ],
  },
  {
    heading: "What's collected",
    body: [
      "The only personal data this site collects is what you submit through the contact form: your name, email address and the type of enquiry you select. Nothing is collected automatically beyond anonymous, aggregated traffic analytics (see below).",
    ],
  },
  {
    heading: "How it's used",
    body: [
      "Contact form submissions are sent by email to route your enquiry to the right inbox and to reply to you. That's the only use: no mailing lists, no marketing sends, no sale or sharing of your details.",
    ],
  },
  {
    heading: "Who processes it",
    body: [
      "One third party runs this site, acting as a data processor:",
    ],
    list: [
      "Cloudflare: hosts the site, delivers the contact form email (your name, email and message pass through Cloudflare Email to reach the inbox), and provides Web Analytics, a cookieless, privacy-first analytics tool that reports aggregated traffic (pages viewed, approximate location, device type) without tracking or identifying individual visitors.",
    ],
  },
  {
    heading: "Cookies",
    body: [
      "This site does not set cookies. Analytics runs on Cloudflare's cookieless beacon, and there's no advertising, tracking pixels or third-party embeds that set cookies either.",
    ],
  },
  {
    heading: "Data retention",
    body: [
      "Contact form emails are kept only as long as needed to handle your enquiry, then deleted in the ordinary course of inbox management.",
    ],
  },
  {
    heading: "Your rights",
    body: [
      "Under UK GDPR you can ask what data is held about you, ask for it to be corrected or deleted, or object to how it's used. Email the address below and it'll be actioned directly; there's no automated system to navigate.",
    ],
  },
  {
    heading: "Contact",
    body: [`Questions about this policy or a request about your data: `],
    email: true,
  },
];
---

<Layout
  title="Privacy | Gareth Matthews"
  description="Privacy policy for garethmatthews.uk: what data is collected, how it's used, and your rights."
>
  <main id="main-content" class="frame pt-8 md:pt-12">
    <PageHead title="Privacy">What this site collects, why, and your rights. Last updated {LAST_UPDATED}.</PageHead>
    <div class="grid-12 mt-10 border-t border-fg pt-6 md:mt-14">
      <div class="col-span-4 space-y-10 md:col-span-7">
        {
          sections.map((section) => (
            <section>
              <h2 class="meta">{section.heading}</h2>
              <div class="prose mt-3">
                {section.body.map((p) => (
                  <p>
                    {p}
                    {section.email && <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>}
                  </p>
                ))}
                {section.list && (
                  <ul>
                    {section.list.map((item) => <li>{item}</li>)}
                  </ul>
                )}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
