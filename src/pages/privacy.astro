---
import Layout from "../layouts/Layout.astro";
import SectionLabel from "../components/SectionLabel.astro";

const CONTACT_EMAIL = "hello@departmnt.xyz";
const LAST_UPDATED = "23 September 2026";

const sections = [
  {
    heading: "What this covers",
    body: [
      "This policy covers garethmatthews.uk — this site only, not DEPARTMNT's own product or client platforms.",
    ],
  },
  {
    heading: "What's collected",
    body: [
      "The only personal data this site collects is what you submit through the contact form: your name, email address and the type of enquiry you select. Nothing is collected automatically beyond anonymous, aggregated traffic analytics (see below).",
    ],
  },
  {
    heading: "How it's used",
    body: [
      "Contact form submissions are sent by email to route your enquiry to the right inbox and to reply to you. That's the only use — no mailing lists, no marketing sends, no sale or sharing of your details.",
    ],
  },
  {
    heading: "Who processes it",
    body: [
      "Two third parties are involved in running this site, both acting as data processors:",
    ],
    list: [
      "Resend — delivers the contact form email. Your name, email and message pass through their systems to reach the inbox.",
      "Cloudflare — hosts the site and provides Web Analytics, a cookieless, privacy-first analytics tool that reports aggregated traffic (pages viewed, approximate location, device type) without tracking or identifying individual visitors.",
    ],
  },
  {
    heading: "Cookies",
    body: [
      "This site does not set cookies. Analytics runs on Cloudflare's cookieless beacon, and there's no advertising, tracking pixels or third-party embeds that set cookies either.",
    ],
  },
  {
    heading: "Data retention",
    body: [
      "Contact form emails are kept only as long as needed to handle your enquiry, then deleted in the ordinary course of inbox management.",
    ],
  },
  {
    heading: "Your rights",
    body: [
      "Under UK GDPR you can ask what data is held about you, ask for it to be corrected or deleted, or object to how it's used. Email the address below and it'll be actioned directly — there's no automated system to navigate.",
    ],
  },
  {
    heading: "Contact",
    body: [`Questions about this policy or a request about your data: `],
    email: true,
  },
];
---

<Layout
  title="Privacy — Gareth Matthews"
  description="Privacy policy for garethmatthews.uk: what data is collected, how it's used, and your rights."
>
  <main id="main-content" class="mx-auto max-w-[1480px] px-5 pt-32 pb-28 sm:px-10">
    <SectionLabel mark="PRIVACY" number="07" subtitle="Plain Terms" />

    <h1 class="mt-10 max-w-2xl text-5xl font-semibold tracking-tight sm:text-7xl">Privacy Policy</h1>
    <p class="mt-4 text-sm text-muted">Last updated {LAST_UPDATED}</p>

    <div class="mt-16 max-w-2xl space-y-12">
      {
        sections.map((section) => (
          <section>
            <h2 class="text-xs font-semibold uppercase tracking-widest text-muted">{section.heading}</h2>
            {section.body.map((p) => (
              <p class="mt-3 text-lg leading-relaxed text-paper/90">
                {p}
                {section.email && (
                  <a
                    href={`mailto:${CONTACT_EMAIL}`}
                    class="underline decoration-paper/30 underline-offset-4 hover:text-muted"
                  >
                    {CONTACT_EMAIL}
                  </a>
                )}
              </p>
            ))}
            {section.list && (
              <ul class="mt-4 space-y-2">
                {section.list.map((item) => (
                  <li class="text-lg leading-relaxed text-paper/90">— {item}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </main>
</Layout>
