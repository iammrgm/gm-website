---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getVisibleThoughts } from "../../lib/thoughts";
import { PERSON_ID } from "../../lib/identity";

export async function getStaticPaths() {
  const allThoughts = await getVisibleThoughts();
  return allThoughts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, date, cover, carousel, reel, video, draft } = entry.data;
const { Content } = await render(entry);

const allThoughts = await getVisibleThoughts();
const currentIndex = allThoughts.findIndex((t) => t.id === entry.id);
const prevThought = currentIndex > 0 ? allThoughts[currentIndex - 1] : null;
const nextThought = currentIndex < allThoughts.length - 1 ? allThoughts[currentIndex + 1] : null;

const dateFormatter = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" });

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: date.toISOString(),
  author: { "@id": PERSON_ID },
  publisher: { "@id": PERSON_ID },
  mainEntityOfPage: new URL(`/thoughts/${entry.id}/`, Astro.site).toString(),
};
---

<Layout title={`${title} | Gareth Matthews`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <main id="main-content" class="frame pt-10 md:pt-14">
    <div class="grid-12">
      <div class="col-span-4 md:col-span-9 md:col-start-4">
        <p class="meta">
          <a href="/thoughts" class="hover:text-fg">Thoughts</a> · {dateFormatter.format(date)}
          {draft && <span> · Draft, not published</span>}
        </p>
        <h1 class="display mt-4 text-[11vw] md:text-[5.6vw] 2xl:text-[80px]">{title}</h1>
        <p class="mt-6 max-w-[28em] text-[22px] leading-[1.3] tracking-[-0.01em] text-mute md:text-[26px]">{description}</p>
      </div>
    </div>

    {
      cover && (
        <img src={cover} alt="" class="mt-12 aspect-[16/9] w-full rounded-xl bg-tint object-cover" />
      )
    }

    <div class="grid-12 mt-12 border-t border-fg pt-8">
      <article class="prose col-span-4 md:col-span-7 md:col-start-4">
        <Content />
      </article>
    </div>

    {
      video && (
        <div class="grid-12 mt-12">
          <video src={video} controls playsinline class="col-span-4 w-full rounded-xl bg-tint md:col-span-7 md:col-start-4">
            <track kind="captions" />
          </video>
        </div>
      )
    }
    {
      reel && (
        <div class="grid-12 mt-12">
          <video src={reel} controls loop playsinline muted class="col-span-2 w-full rounded-xl bg-tint md:col-span-3 md:col-start-4">
            <track kind="captions" />
          </video>
        </div>
      )
    }
    {
      carousel.length > 0 && (
        <ul class="grid-12 mt-12 gap-y-6">
          {carousel.map((src, i) => (
            <li class="col-span-4 md:col-span-6">
              <img src={src} alt={`${title}, image ${i + 1} of ${carousel.length}`} loading="lazy" class="aspect-[4/3] w-full rounded-xl bg-tint object-cover" />
            </li>
          ))}
        </ul>
      )
    }

    <nav class="grid-12 mt-20 border-t border-fg pt-4" aria-label="More thoughts">
      {prevThought ? (
        <a href={`/thoughts/${prevThought.id}`} class="group col-span-2 md:col-span-6">
          <span class="meta">Newer</span>
          <span class="mt-1 block text-[17px] font-medium underline-offset-[0.2em] group-hover:underline">{prevThought.data.title}</span>
        </a>
      ) : (
        <span class="col-span-2 md:col-span-6" />
      )}
      {nextThought ? (
        <a href={`/thoughts/${nextThought.id}`} class="group col-span-2 text-right md:col-span-6">
          <span class="meta">Older</span>
          <span class="mt-1 block text-[17px] font-medium underline-offset-[0.2em] group-hover:underline">{nextThought.data.title}</span>
        </a>
      ) : (
        <span class="col-span-2 md:col-span-6" />
      )}
    </nav>
  </main>
</Layout>
