---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const allThoughts = await getCollection("thoughts");
  return allThoughts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, date, cover, carousel, reel, video } = entry.data;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);

const allThoughts = (await getCollection("thoughts")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = allThoughts.findIndex((t) => t.id === entry.id);
const prevThought = currentIndex > 0 ? allThoughts[currentIndex - 1] : null;
const nextThought = currentIndex < allThoughts.length - 1 ? allThoughts[currentIndex + 1] : null;

const dateFormatter = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" });

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: date.toISOString(),
  author: { "@type": "Person", name: "Gareth Matthews" },
};
---

<Layout title={`${title} | Gareth Matthews`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <main id="main-content" class="mx-auto max-w-[1480px] px-5 pt-32 pb-28 sm:px-10">
    <a href="/thoughts" class="text-sm text-muted transition-colors hover:text-paper">Thoughts /</a>
    <p class="mt-4 text-xs font-semibold uppercase tracking-widest text-muted">
      {dateFormatter.format(date)}
    </p>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">{title}</h1>

    {
      cover && (
        <div class="mt-10 aspect-video w-full max-w-3xl overflow-hidden rounded-2xl bg-line/20" data-reveal>
          <img src={cover} alt={title} class="h-full w-full object-cover" />
        </div>
      )
    }

    {
      sections.length > 1 && (
        <nav class="mt-10 max-w-md rounded-2xl border border-line p-6" aria-label="Contents">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Contents</p>
          <ol class="mt-4 space-y-2">
            {sections.map((section, i) => (
              <li>
                <a
                  href={`#${section.slug}`}
                  class="flex gap-3 text-sm text-paper/80 transition-colors hover:text-paper"
                >
                  <span class="text-muted">{String(i + 1).padStart(2, "0")}</span>
                  {section.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <article class="prose-thought mt-16 max-w-2xl space-y-6 text-lg text-paper/90">
      <Content />
    </article>

    {
      video && (
        <div class="mt-16 aspect-video w-full max-w-3xl overflow-hidden rounded-2xl bg-line/20" data-reveal>
          <video src={video} controls playsinline class="h-full w-full object-cover">
            <track kind="captions" />
          </video>
        </div>
      )
    }

    {
      reel && (
        <div class="mt-16 aspect-[9/16] w-full max-w-xs overflow-hidden rounded-2xl bg-line/20" data-reveal>
          <video src={reel} controls loop playsinline muted class="h-full w-full object-cover">
            <track kind="captions" />
          </video>
        </div>
      )
    }

    {
      carousel.length > 0 && (
        <div class="mt-16 grid max-w-3xl gap-4 sm:grid-cols-2" data-reveal>
          {carousel.map((src, i) => (
            <div class="aspect-[4/3] w-full overflow-hidden rounded-lg bg-line/20">
              <img
                src={src}
                alt={`${title}, image ${i + 1} of ${carousel.length}`}
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>
          ))}
        </div>
      )
    }

    <div class="mt-16 grid gap-6 border-t border-line pt-10 sm:grid-cols-2">
      {prevThought ? (
        <a href={`/thoughts/${prevThought.id}`} class="group">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">← Newer</p>
          <p class="mt-2 text-lg font-medium text-paper underline decoration-paper/30 underline-offset-4 group-hover:decoration-paper">
            {prevThought.data.title}
          </p>
        </a>
      ) : <span />}
      {nextThought ? (
        <a href={`/thoughts/${nextThought.id}`} class="group text-left sm:text-right">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Older →</p>
          <p class="mt-2 text-lg font-medium text-paper underline decoration-paper/30 underline-offset-4 group-hover:decoration-paper">
            {nextThought.data.title}
          </p>
        </a>
      ) : <span />}
    </div>

    <a
      href="/thoughts"
      class="mt-10 inline-block text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4"
    >
      ← Back to Thoughts
    </a>
  </main>
</Layout>

<style>
  .prose-thought :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-paper);
    margin-top: 2rem;
  }
  .prose-thought :global(p) {
    margin-top: 0.75rem;
    color: rgba(245, 244, 241, 0.75);
  }
</style>
