---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";

import { getVisibleThoughts } from "../../lib/thoughts";

const allThoughts = await getVisibleThoughts();

const dateFormatter = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<Layout
  noindex={allThoughts.length === 0}
  title="Thoughts | Gareth Matthews"
  description="Short pieces on presence, connected products, culture and building DEPARTMNT."
>
  <main id="main-content" class="frame pt-8 md:pt-12">
    <PageHead title="Thoughts">
      Short perspectives on culture, commerce and the rooms where they meet. Longer pieces go out on{" "}
      <a href="https://iammrgm.substack.com/" target="_blank" rel="me noopener noreferrer" class="ln">Substack</a>.
    </PageHead>
    <div class="mt-10 border-t border-fg pt-3 md:mt-14">
      {
        allThoughts.length === 0 ? (
          <>
            <p class="meta">Short Perspectives</p>
            <p class="mt-4 text-[34px] leading-[1.02] font-medium tracking-[-0.03em] md:mt-5 md:text-[48px]">Coming soon</p>
          </>
        ) : (
          <ul>
            {allThoughts.map((entry) => (
              <li class="border-b border-rule">
                <a href={`/thoughts/${entry.id}/`} class="group grid-12 gap-y-2 py-5">
                  <span class="col-span-4 md:col-span-8">
                    <span class="block text-[22px] leading-snug font-medium tracking-[-0.01em] underline-offset-[0.2em] group-hover:underline md:text-[26px]">
                      {entry.data.title}
                    </span>
                    <span class="mt-1 block max-w-[36em] text-[17px] text-mute">{entry.data.description}</span>
                  </span>
                  <span class="meta col-span-4 md:col-span-4 md:pt-2 md:text-right">
                    {dateFormatter.format(entry.data.date)}
                    {entry.data.draft && <span class="block">Draft</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </main>
</Layout>
