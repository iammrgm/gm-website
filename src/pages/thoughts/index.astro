---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SectionLabel from "../../components/SectionLabel.astro";

const allThoughts = (await getCollection("thoughts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<Layout
  title="Thoughts | Gareth Matthews"
  description="Short perspective pieces on connected products, culture and building DEPARTMNT."
>
  <main id="main-content" class="mx-auto max-w-[1480px] px-5 pt-32 pb-28 sm:px-10">
    <SectionLabel mark="THOUGHTS" number="08" subtitle="Short Perspectives" />

    <h1 class="mt-10 max-w-2xl text-5xl font-semibold tracking-tight sm:text-7xl">Thoughts</h1>

    {
      allThoughts.length === 0 ? (
        <p class="mt-16 max-w-lg text-lg text-muted">Nothing published here yet, check back soon.</p>
      ) : (
        <div class="mt-16 divide-y divide-line border-t border-line" data-reveal>
          {allThoughts.map((entry) => (
            <a href={`/thoughts/${entry.data.slug}`} class="group block py-8 transition-colors hover:bg-paper/[0.03]">
              <p class="text-xs font-semibold uppercase tracking-widest text-muted">
                {dateFormatter.format(entry.data.date)}
              </p>
              <h2 class="mt-3 max-w-2xl text-2xl font-semibold tracking-tight text-paper sm:text-3xl">
                {entry.data.title}
              </h2>
              <p class="mt-2 max-w-2xl text-muted">{entry.data.description}</p>
              <span class="mt-4 inline-block text-sm font-medium text-paper underline decoration-paper/30 underline-offset-4">
                Read {entry.data.title} →
              </span>
            </a>
          ))}
        </div>
      )
    }
  </main>
</Layout>
