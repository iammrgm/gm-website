{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-21",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "gareth-matthews-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Explicit so PR/branch preview builds can bind it too — Cloudflare's
	// automatic provisioning (mentioned in the Astro adapter docs) only
	// wires this up for the production deployment, not preview ones, which
	// otherwise fail with "binding SESSION ... must have a namespace_id".
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "9b9d094e35064eb288439c31ed00b8c4"
		}
	],
	"observability": {
		"enabled": true
	}
}